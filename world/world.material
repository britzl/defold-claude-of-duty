name: "generated_world"
tags: "model"
vertex_program: "/world/world.vp"
fragment_program: "/world/world.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
vertex_constants {
  name: "world_view"
  type: CONSTANT_TYPE_WORLDVIEW
}
fragment_constants {
  name: "surface"
  type: CONSTANT_TYPE_USER
  value { x: 0 y: 0 z: 0 w: 0 }
}
