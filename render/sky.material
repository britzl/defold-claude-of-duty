name: "sky"
tags: "fullscreen"
vertex_program: "/render/composite.vp"
fragment_program: "/render/sky.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants { name: "inverse_view_proj" type: CONSTANT_TYPE_USER_MATRIX4 value { x: 1 y: 0 z: 0 w: 0 } value { x: 0 y: 1 z: 0 w: 0 } value { x: 0 y: 0 z: 1 w: 0 } value { x: 0 y: 0 z: 0 w: 1 } }
fragment_constants { name: "eye_position" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "colour_pipeline" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "daylight_data" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "sky_texture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
fragment_constants { name: "atmosphere_data" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
