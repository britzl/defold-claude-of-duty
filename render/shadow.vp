attribute highp vec3 position;
attribute mediump vec3 normal;
attribute lowp vec4 color;
uniform highp mat4 view_proj;
uniform highp mat4 sun_matrix;
varying highp float var_shadow_depth;
varying highp vec3 var_cutout_position;
varying mediump vec3 var_cutout_normal;
varying lowp float var_coverage;
void main() {
    var_cutout_position=position;var_cutout_normal=normal;var_coverage=color.a;
    gl_Position=view_proj*vec4(position,1.0);
    var_shadow_depth=(sun_matrix*vec4(position,1.0)).z*0.5+0.5;
}
