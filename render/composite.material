name: "composite"
tags: "fullscreen"
vertex_program: "/render/composite.vp"
fragment_program: "/render/composite.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants { name: "post" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "scene_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "weapon_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "bloom_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "debug_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_NEAREST filter_mag: FILTER_MODE_MAG_NEAREST }
samplers { name: "environment_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
fragment_constants { name: "colour_pipeline" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "atlas_window" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 1 w: 1 } }
fragment_constants { name: "environment_layout" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "environment_debug" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "photo" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "photo_screen" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "exposure_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "grade_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
