attribute highp vec3 position;
attribute highp vec4 joint_indices;
attribute highp vec4 joint_weights;
uniform highp mat4 world;
uniform highp mat4 view_proj;
uniform highp mat4 sun_matrix;
#include "/soldiers/skinning.glsl"
varying highp float var_shadow_depth;
varying highp vec3 var_cutout_position;
varying mediump vec3 var_cutout_normal;
varying lowp float var_coverage;
void main() {
    vec4 p=world*skin_matrix(joint_indices,joint_weights)*vec4(position,1.0);
    // Soldier alpha is camouflage weight, not surface coverage.
    var_cutout_position=p.xyz;var_cutout_normal=vec3(0,1,0);var_coverage=1.0;
    gl_Position=view_proj*p;
    var_shadow_depth=(sun_matrix*p).z*0.5+0.5;
}
