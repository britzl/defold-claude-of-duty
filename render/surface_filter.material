name: "surface_filter"
tags: "fullscreen"
vertex_program: "/render/composite.vp"
fragment_program: "/render/surface_filter.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants { name: "source_rect" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "filter_params" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "source_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "height_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
