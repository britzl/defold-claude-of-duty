name: "capture_laboratory"
tags: "capture_lab"
tags: "capture_lab_shadow"
vertex_program: "/world/world.vp"
fragment_program: "/world/world.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
fragment_constants { name: "surface" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "shadow_data" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "eye_position" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "features" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "light_positions" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "light_colours" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "light_minimums" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "light_maximums" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "shadow_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_NEAREST filter_mag: FILTER_MODE_MAG_NEAREST }
samplers { name: "environment_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "albedo_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "normal_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "material_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
fragment_constants { name: "colour_pipeline" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "surface_rects" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "surface_info" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "surface_effects" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "weather_features" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "indirect" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "environment_layout" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "lighting_features" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "daylight_data" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "volume_data" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "occlusion_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_NEAREST filter_mag: FILTER_MODE_MAG_NEAREST }
fragment_constants { name: "screen_effects" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
