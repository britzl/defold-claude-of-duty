name: "bloom"
tags: "fullscreen"
vertex_program: "/render/composite.vp"
fragment_program: "/render/bloom.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants { name: "bloom_step" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "source_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
