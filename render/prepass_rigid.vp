attribute highp vec3 position;
attribute mediump vec3 normal;
attribute lowp vec4 color;
uniform highp mat4 view_proj;
uniform highp mat4 view;
uniform highp mat4 world;
uniform highp mat4 previous_world;
varying highp vec3 var_position;
varying mediump vec3 var_normal;
varying highp float var_depth;
varying mediump vec3 var_view_normal;
varying lowp float var_coverage;
uniform highp mat4 previous_view_proj;
uniform highp mat4 previous_view;
varying highp vec4 var_current_clip;
varying highp vec4 var_previous_clip;
varying highp float var_previous_depth;
varying mediump vec3 var_previous_normal;
void main() {
    vec3 p=(world*vec4(position,1.0)).xyz;
    vec3 old=(previous_world*vec4(position,1.0)).xyz;
    vec3 n=(world*vec4(normal,0.0)).xyz;
    var_position=p;var_normal=n;var_coverage=1.0;
    var_depth=-(view*vec4(p,1.0)).z;
    var_view_normal=(view*vec4(n,0.0)).xyz;
    var_current_clip=view_proj*vec4(p,1.0);
    var_previous_clip=previous_view_proj*vec4(old,1.0);
    var_previous_depth=-(previous_view*vec4(old,1.0)).z;
    var_previous_normal=(previous_view*previous_world*vec4(normal,0.0)).xyz;
    gl_Position=var_current_clip;
}
