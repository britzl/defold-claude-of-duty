name: "local_shadow_skinned"
tags: "shadow_pass"
vertex_program: "/render/shadow_skinned.vp"
fragment_program: "/render/local_shadow.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "world" type: CONSTANT_TYPE_WORLD }
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
vertex_constants { name: "bone_palette" type: CONSTANT_TYPE_USER_MATRIX4 value { x: 1 y: 0 z: 0 w: 0 } value { x: 0 y: 1 z: 0 w: 0 } value { x: 0 y: 0 z: 1 w: 0 } value { x: 0 y: 0 z: 0 w: 1 } }
vertex_constants { name: "sun_matrix" type: CONSTANT_TYPE_USER_MATRIX4 value { x: 1 y: 0 z: 0 w: 0 } value { x: 0 y: 1 z: 0 w: 0 } value { x: 0 y: 0 z: 1 w: 0 } value { x: 0 y: 0 z: 0 w: 1 } }
fragment_constants { name: "local_shadow_position" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 1 } }
fragment_constants { name: "coverage_rects" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "coverage_info" type: CONSTANT_TYPE_USER value { x: .6 y: 256 z: 8 w: .45 } }
samplers { name: "coverage_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
