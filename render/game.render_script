-- Generated maps/sky -> sun shadows -> depth/normals -> AO/contact -> world
-- -> temporal resolve -> isolated weapon AA -> bloom -> tone mapping -> GUI.
local settings=require "game.render.settings"
local atlas=require "game.render.surface_atlas"
local daylight=require "game.render.daylight"
local shadows=require "game.render.shadows"
local temporal=require "game.render.temporal"
local G=graphics
local COLOR,DEPTH=G.BUFFER_TYPE_COLOR0_BIT,G.BUFFER_TYPE_DEPTH_BIT
local MOTION,EXPECTED=G.BUFFER_TYPE_COLOR1_BIT,G.BUFFER_TYPE_COLOR2_BIT
local WORLD_CAMERA="main:/camera#camera"
local WEAPON_CAMERA="main:/viewmodel#camera"
local function colour_target(w,h,depth,nearest,cube,format)
    local params={ [COLOR]={format=format or G.TEXTURE_FORMAT_RGBA,width=w,height=h,
        min_filter=nearest and G.TEXTURE_FILTER_NEAREST or G.TEXTURE_FILTER_LINEAR,
        mag_filter=nearest and G.TEXTURE_FILTER_NEAREST or G.TEXTURE_FILTER_LINEAR,
        u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE} }
    if depth then params[DEPTH]={format=G.TEXTURE_FORMAT_DEPTH,width=w,height=h} end
    if cube then params.type=G.TEXTURE_TYPE_CUBE_MAP end
    return render.render_target(params)
end
local function prepass_target(w,h)
    local params={}
    for _,attachment in ipairs({COLOR,MOTION,EXPECTED}) do
        params[attachment]={format=G.TEXTURE_FORMAT_RGBA,width=w,height=h,
            min_filter=G.TEXTURE_FILTER_NEAREST,mag_filter=G.TEXTURE_FILTER_NEAREST,
            u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE}
    end
    params[DEPTH]={format=G.TEXTURE_FORMAT_DEPTH,width=w,height=h}
    return render.render_target(params)
end
local function world_camera(self)
    render.set_camera()
    render.set_view(self.world_view)
    render.set_projection(self.world_projection)
end
local function resize(self)
    local d=settings.dimensions(render.get_window_width(),render.get_window_height())
    if not d then return false end
    if d.width~=self.width or d.height~=self.height then
        self.width,self.height=d.width,d.height
        self.bloom_width,self.bloom_height=d.bloom_width,d.bloom_height
        self.occlusion_width,self.occlusion_height=d.occlusion_width,d.occlusion_height
        for _,name in ipairs({"scene","weapon","bloom_a","bloom_b","history_a","history_b","weapon_aa"}) do
            local small=name=="bloom_a" or name=="bloom_b"
            local w,h=small and d.bloom_width or d.width,small and d.bloom_height or d.height
            if self.targets[name] then render.set_render_target_size(self.targets[name],w,h)
            else self.targets[name]=colour_target(w,h,name=="scene" or name=="weapon",false,false,self.radiance_format) end
        end
        for _,name in ipairs({"depth_normal","depth_previous","occlusion_raw","occlusion"}) do
            local half=name=="occlusion_raw"
            local w,h=half and d.occlusion_width or d.width,half and d.occlusion_height or d.height
            if self.targets[name] then render.set_render_target_size(self.targets[name],w,h)
            else self.targets[name]=(name=="depth_normal" or name=="depth_previous") and prepass_target(w,h) or colour_target(w,h,false,true) end
        end
        self.gui_projection=vmath.matrix4_orthographic(0,d.width,0,d.height,-1,1)
        self.resizes=self.resizes+1
        temporal.reset(self.temporal,"resize")
        self.report=true
    end
    return true
end
local function fullscreen(self,material,constants,blend)
    render.set_camera()
    render.set_view(self.identity)
    render.set_projection(self.identity)
    render.set_depth_mask(false)
    render.disable_state(G.STATE_DEPTH_TEST)
    render.disable_state(G.STATE_CULL_FACE)
    render.disable_state(G.STATE_BLEND)
    if blend then
        render.enable_state(G.STATE_BLEND)
        render.set_blend_func(G.BLEND_FACTOR_SRC_ALPHA,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    end
    if material then render.enable_material(material) end
    render.draw(self.quad,{constants=constants})
    if material then render.disable_material() end
end
local function bind(name,target) render.enable_texture(name,target,COLOR) end
local function bake_scratch(self)
    self.targets.atlas_spare=colour_target(atlas.width,atlas.height)
    self.targets.scratch_a=colour_target(atlas.scratch_size,atlas.scratch_size)
    self.targets.scratch_b=colour_target(atlas.scratch_size,atlas.scratch_size)
end
local function release_bake_scratch(self)
    for _,name in ipairs({"atlas_spare","scratch_a","scratch_b"}) do
        render.delete_render_target(self.targets[name]);self.targets[name]=nil
    end
end
local function bake_next(self)
    -- Expensive recipes get their own frame. Cheap copies/mip reductions run
    -- eight at a time, with no world draws until every map is complete.
    if self.bake_step==0 then
        if not self.targets.scratch_a then bake_scratch(self) end
        for _,name in ipairs({"albedo","normal","material"}) do
            render.set_render_target(self.targets[name])
            render.clear({[COLOR]=vmath.vector4()})
        end
    end
    for _=1,8 do
        if self.bake_step>=atlas.job_count then return end
        local job=self.bake_jobs[self.bake_step+1]
        if job then
            if job.op=="recipe" and _>1 then return end
            if job.target~="scratch_a" and job.target~="scratch_b" then
                -- Defold 1.14 Lua targets use DONT_CARE load operations. On
                -- tile GPUs a partial viewport discards neighbouring pixels.
                -- Copy the complete old atlas to a spare, then patch it in the
                -- SAME render pass. Swap ownership; never sample the target.
                local previous=self.targets[job.target]
                render.set_render_target(self.targets.atlas_spare)
                render.set_viewport(0,0,atlas.width,atlas.height)
                self.bake_constants.filter_params=vmath.vector4(0,3,0,0)
                bind("source_texture",previous)
                bind("height_texture",self.targets.scratch_b)
                fullscreen(self,"surface_filter",self.bake_constants)
                render.disable_texture("source_texture")
                render.disable_texture("height_texture")
                self.targets[job.target],self.targets.atlas_spare=self.targets.atlas_spare,previous
                self.bake_draws=self.bake_draws+1
            end
            render.set_render_target(self.targets[job.target])
            if job.op=="recipe" then
                render.set_viewport(0,0,job.size,job.size)
                self.bake_constants.bake=vmath.vector4(job.channel,job.kind,job.size,0)
                fullscreen(self,"bake",self.bake_constants)
            else
                local r,src=job.rect,job.source_rect
                render.set_viewport(r.x,r.y,r.size+2,r.size+2)
                self.bake_constants.source_rect=vmath.vector4(src.x/job.source_width,src.y/job.source_height,
                    src.size/job.source_width,src.size/job.source_height)
                self.bake_constants.filter_params=vmath.vector4(r.size,job.op=="normal" and 2 or job.op=="reduce" and 1 or 0,
                    job.relief or 0,src.size)
                bind("source_texture",self.targets[job.source])
                bind("height_texture",self.targets.scratch_b)
                fullscreen(self,"surface_filter",self.bake_constants)
                render.disable_texture("source_texture")
                render.disable_texture("height_texture")
            end
        else
            -- One complete pass preserves every atlas tile on discard-on-load GPUs.
            render.set_render_target(self.targets.environment)
            render.set_viewport(0,0,daylight.environment_width,daylight.environment_height)
            fullscreen(self,"environment",self.bake_constants)
        end
        self.bake_step=self.bake_step+1
        self.bake_draws=self.bake_draws+1
        self.report=true
        if job and job.op=="recipe" then return end
    end
end
local function report(self)
    if not self.report and self.frames%30~=0 then return end
    self.report=false
    msg.post("main:/controller#script","renderer_stats",{
        ready=self.bake_step==atlas.job_count, bake_jobs=self.bake_step, bake_draws=self.bake_draws,
        atlas_width=atlas.width,atlas_height=atlas.height,material_quality=atlas.quality,surface_count=#atlas.surfaces-1,
        detail_resolution=atlas.surfaces[atlas.detail_kind+1].size,
        environment_faces=self.bake_step==atlas.job_count and 6 or 0, environment_size=settings.environment_size,
        environment_width=daylight.environment_width,environment_height=daylight.environment_height,
        reflection_levels=daylight.reflection_levels,environment_samples=128,volume_count=self.volume_count,
        shadow_size=shadows.size, shadow_atlas_size=shadows.atlas_size, shadow_cascades=shadows.count,
        shadow_splits=shadows.splits, shadow_texels=self.shadow_texels or {}, shadow_frames=self.shadow_frames,
        shadow_draw_passes=self.shadow_draw_passes or 0,
        width=self.width,height=self.height,bloom_width=self.bloom_width,bloom_height=self.bloom_height,
        target_count=self.targets.scratch_a and 19 or 16,
        occlusion_width=self.occlusion_width,occlusion_height=self.occlusion_height,
        prepass_draw_passes=self.prepass_draw_passes or 0,occlusion_draw_passes=self.occlusion_draw_passes or 0,
        occlusion_radius=.85,contact_length=.4,occlusion_slices=4,occlusion_steps=6,contact_steps=12,
        depth_normal_format="rgba8_log_depth_oct_normal",
        target_bytes=settings.target_bytes(self.width,self.height,self.pipeline.hdr,self.targets.scratch_a~=nil),
        peak_target_bytes=settings.target_bytes(self.width,self.height,self.pipeline.hdr,true),resizes=self.resizes,
        local_light_count=self.light_count,frames=self.frames,
        radiance_range=self.pipeline.hdr and 65504 or settings.radiance_range })
    msg.post("main:/controller#script","renderer_details",{
        temporal_age=self.temporal.age,temporal_resets=self.temporal.resets,temporal_reset_reason=self.temporal.reason,
        temporal_samples=temporal.samples,temporal_draw_passes=self.temporal_draw_passes or 0,
        weapon_aa_draw_passes=self.weapon_aa_draw_passes or 0,
        motion_format="rgba8_signed_uv16",history_depth_rejection=true,
        settings=self.options,pipeline=self.pipeline })
end
function init(self)
    self.world=render.predicate({"model"})
    self.static_world=render.predicate({"model","world_shadow"})
    self.laboratory=render.predicate({"capture_lab"})
    self.laboratory_shadow=render.predicate({"capture_lab_shadow"})
    self.capture={active=false,laboratory=false}
    self.world_shadow=render.predicate({"world_shadow"})
    self.soldier_shadow=render.predicate({"soldier_shadow"})
    self.soldier_prepass=render.predicate({"soldier_prepass"})
    self.rigid_prepass=render.predicate({"rigid_prepass"})
    self.weapon=render.predicate({"viewmodel"})
    self.quad=render.predicate({"fullscreen"})
    self.gui=render.predicate({"gui"})
    self.debug=render.predicate({"debug_text"})
    self.identity=vmath.matrix4()
    self.options=settings.defaults()
    self.pipeline=settings.pipeline(G.get_adapter_info(),G.TEXTURE_FORMAT_RGBA16F,sys.get_config_string("render.hdr","auto"))
    self.radiance_format=self.pipeline.hdr and G.TEXTURE_FORMAT_RGBA16F or G.TEXTURE_FORMAT_RGBA
    self.targets={}
    self.temporal=temporal.new()
    self.frames,self.bake_step,self.bake_draws,self.resizes,self.shadow_frames=0,0,0,0,0
    self.bake_jobs=atlas.jobs()
    self.light_count=0
    self.volume_count=0
    self.lighting=render.constant_buffer()
    self.lighting.surface_rects=atlas.rects(vmath.vector4)
    self.bake_constants=render.constant_buffer()
    self.sky_constants=render.constant_buffer()
    self.post_constants=render.constant_buffer()
    self.bloom_constants=render.constant_buffer()
    self.probe_constants=render.constant_buffer()
    self.occlusion_constants=render.constant_buffer()
    self.motion_constants=render.constant_buffer()
    self.temporal_constants=render.constant_buffer()
    self.aa_constants=render.constant_buffer()
    for _,constants in ipairs({self.lighting,self.bake_constants,self.sky_constants,self.post_constants,self.bloom_constants,self.probe_constants,self.temporal_constants,self.aa_constants}) do
        constants.colour_pipeline=vmath.vector4(self.pipeline.hdr and 1 or 0,0,0,0)
    end
    for _,name in ipairs({"light_positions","light_colours","light_minimums","light_maximums"}) do
        self.lighting[name]={vmath.vector4(),vmath.vector4(),vmath.vector4(),vmath.vector4()}
    end
    for _,constants in ipairs({self.lighting,self.bake_constants,self.sky_constants,self.post_constants}) do
        for name,value in pairs(daylight.constants(vmath.vector4)) do constants[name]=value end
    end
    self.lighting.volume_data={}
    for i=1,daylight.max_volumes*5 do self.lighting.volume_data[i]=vmath.vector4() end
    self.cascade_constants={}
    for i=1,shadows.count do self.cascade_constants[i]=render.constant_buffer() end
    self.targets.shadow=colour_target(shadows.atlas_size,shadows.atlas_size,true,true)
    for _,name in ipairs({"albedo","normal","material"}) do
        self.targets[name]=colour_target(atlas.width,atlas.height)
    end
    bake_scratch(self)
    self.targets.environment=colour_target(daylight.environment_width,daylight.environment_height,false,false,false,self.radiance_format)
    resize(self)
    render.set_listener(function(_,event)
        if event==render.CONTEXT_EVENT_CONTEXT_RESTORED then
            -- Runtime render-target contents are transient across context loss.
            self.bake_step=0
            temporal.reset(self.temporal,"context_restored")
            self.report=true
        end
    end)
end
function update(self)
    if not resize(self) then return end
    self.frames=self.frames+1
    -- Previous frame's queued bake draws have now consumed these resources.
    if self.bake_step==atlas.job_count and self.targets.scratch_a then release_bake_scratch(self) end
    bake_next(self)
    local t,o=self.targets,self.options
    if self.bake_step==atlas.job_count then
        -- Capture the same interpolated camera used by the world and weapon.
        local view=camera.get_view(WORLD_CAMERA)
        local projection=camera.get_projection(WORLD_CAMERA)
        local inverse_view=vmath.inv(view)
        if temporal.cut(self.previous_inverse_view,inverse_view) then temporal.reset(self.temporal,"camera_cut") end
        if self.previous_projection and (math.abs(projection.m00-self.previous_projection.m00)>.15
            or math.abs(projection.m11-self.previous_projection.m11)>.15) then temporal.reset(self.temporal,"projection_cut") end
        local taa=o.temporal_aa and (o.view=="scene" or o.view=="motion" or o.view=="history")
        local frozen=taa and self.capture.active and not self.capture.temporal_live and self.temporal.age>=temporal.capture_samples
        local advance=taa and not frozen
        local jx,jy=0,0
        if taa then jx,jy=temporal.jitter(frozen and temporal.capture_samples-1 or self.temporal.age) end
        local unjittered=projection
        projection=vmath.matrix4(projection)
        projection.m02=projection.m02-2*jx/self.width
        projection.m12=projection.m12-2*jy/self.height
        self.world_view,self.world_projection=view,projection
        local previous_view=self.temporal.age>0 and self.previous_view or view
        local previous_projection=self.temporal.age>0 and self.previous_jitter_projection or projection
        self.motion_constants.previous_view=previous_view
        self.motion_constants.previous_view_proj=previous_projection*previous_view
        if advance then t.depth_normal,t.depth_previous=t.depth_previous,t.depth_normal end
        local eye=inverse_view*vmath.vector4(0,0,0,1)
        self.lighting.eye_position=eye
        self.lighting.weather_features=vmath.vector4(o.weathering and 1 or 0,o.micro_detail and 1 or 0,
            o.parallax and atlas.quality~="low" and 1 or 0,atlas.surfaces[atlas.detail_kind+1].size)
        self.lighting.features=vmath.vector4(o.shadows and 1 or 0,o.normal_maps and 1 or 0,
            o.local_lights and 1 or 0,o.fog and 1 or 0)
        local fits,matrices,data=shadows.update(inverse_view,projection,daylight.sun_direction,vmath.vector4,vmath.matrix4)
        data[18].w=o.view=="cascades" and 1 or o.view=="shadow_visibility" and 2 or 0
        self.lighting.shadow_data=data
        self.shadow_texels={fits[1].texel,fits[2].texel,fits[3].texel,fits[4].texel}
        self.lighting.lighting_features=vmath.vector4(o.interior_lighting and not self.capture.laboratory and 1 or 0,
            o.environment_filter and 1 or 0,self.volume_count,0)
        self.lighting.lighting_transform=self.identity
        self.sky_constants.eye_position=eye
        self.sky_constants.inverse_view_proj=vmath.inv(projection*view)

        -- Clear every frame even when disabled, so re-enabling cannot expose stale data.
        render.set_camera()
        render.set_render_target(t.shadow)
        render.set_viewport(0,0,shadows.atlas_size,shadows.atlas_size)
        render.set_depth_mask(true)
        render.disable_state(G.STATE_BLEND)
        render.enable_state(G.STATE_DEPTH_TEST)
        render.enable_state(G.STATE_CULL_FACE)
        render.set_depth_func(G.COMPARE_FUNC_LEQUAL)
        render.clear({[COLOR]=vmath.vector4(1,0,0,1),[DEPTH]=1})
        self.shadow_draw_passes=0
        if o.shadows then
            -- Bind/clear ONCE: switching targets between tiles discards earlier
            -- cascades on tile GPUs. Each draw keeps its own immutable constants.
            render.set_view(self.identity)
            for i,fit in ipairs(fits) do
                local vp=fit.viewport
                render.set_viewport(vp[1],vp[2],vp[3],vp[4])
                render.set_projection(matrices[i])
                local constants=self.cascade_constants[i]
                constants.sun_matrix=matrices[i]
                render.enable_material("shadow")
                render.draw(self.capture.laboratory and self.laboratory_shadow or self.world_shadow,
                    {constants=constants,frustum=matrices[i]})
                self.shadow_draw_passes=self.shadow_draw_passes+1
                if not self.capture.active then
                    render.enable_material("shadow_skinned")
                    render.draw(self.soldier_shadow,{constants=constants,frustum=matrices[i]})
                    self.shadow_draw_passes=self.shadow_draw_passes+1
                end
            end
            render.disable_material()
            self.shadow_frames=self.shadow_frames+1
        end

        -- World geometry only; identical skinning and cutouts to colour/shadows.
        -- This data target is deliberately portable RGBA8, independent of HDR.
        local screen_debug=settings.views[o.view]>=10
        local need_depth=o.ambient_occlusion or o.contact_shadows or screen_debug or taa
        self.prepass_draw_passes,self.occlusion_draw_passes=0,0
        render.set_render_target(t.depth_normal)
        render.set_viewport(0,0,self.width,self.height)
        render.set_depth_mask(true)
        render.clear({[COLOR]=vmath.vector4(1,0,.5,.5),[DEPTH]=1})
        if need_depth then
            world_camera(self)
            render.enable_material("prepass")
            render.draw(self.capture.laboratory and self.laboratory_shadow or self.world_shadow,{constants=self.motion_constants,frustum=projection*view})
            render.disable_material()
            self.prepass_draw_passes=1
            if not self.capture.active then
                render.draw(self.soldier_prepass,{constants=self.motion_constants,frustum=projection*view})
                render.draw(self.rigid_prepass,{constants=self.motion_constants,frustum=projection*view})
                self.prepass_draw_passes=3
            end
            render.disable_material()
        end
        local constants=self.occlusion_constants
        constants.screen_projection=vmath.vector4(projection.m00,projection.m11,projection.m02,projection.m12)
        constants.screen_size=vmath.vector4(self.width,self.height,self.occlusion_width,self.occlusion_height)
        constants.occlusion_params=vmath.vector4(.85,.4,o.ambient_occlusion and 1 or 0,o.contact_shadows and 1 or 0)
        local sun=daylight.sun_direction
        constants.sun_view=view*vmath.vector4(sun[1],sun[2],sun[3],0)
        render.set_render_target(t.occlusion_raw)
        render.set_viewport(0,0,self.occlusion_width,self.occlusion_height)
        if o.ambient_occlusion or o.contact_shadows then
            bind("depth_normal_texture",t.depth_normal)
            fullscreen(self,"occlusion",constants)
            render.set_render_target(t.occlusion)
            render.set_viewport(0,0,self.width,self.height)
            bind("occlusion_texture",t.occlusion_raw)
            fullscreen(self,"occlusion_filter",constants)
            render.disable_texture("depth_normal_texture")
            render.disable_texture("occlusion_texture")
            self.occlusion_draw_passes=2
        else
            render.clear({[COLOR]=vmath.vector4(1)})
            render.set_render_target(t.occlusion)
            render.clear({[COLOR]=vmath.vector4(1)})
        end
        self.lighting.screen_effects=vmath.vector4(1/self.width,1/self.height,
            o.ambient_occlusion and 1 or 0,o.contact_shadows and 1 or 0)

        render.set_render_target(t.scene)
        render.set_viewport(0,0,self.width,self.height)
        render.set_depth_mask(true)
        render.clear({[COLOR]=vmath.vector4(0,0,0,1),[DEPTH]=1})
        fullscreen(self,"sky",self.sky_constants)
        bind("occlusion_texture",t.occlusion)
        bind("shadow_texture",t.shadow)
        bind("environment_texture",t.environment)
        bind("albedo_texture",t.albedo)
        bind("normal_texture",t.normal)
        bind("material_texture",t.material)
        render.enable_state(G.STATE_DEPTH_TEST)
        render.enable_state(G.STATE_CULL_FACE)
        render.set_depth_mask(true)
        world_camera(self)
        local scene=self.capture.laboratory and self.laboratory or self.capture.active and self.static_world or self.world
        render.draw(scene,{constants=self.lighting,frustum=projection*view})
        if not self.capture.active then render.draw_debug3d() end

        render.disable_texture("occlusion_texture")
        render.set_render_target(t.weapon)
        render.clear({[COLOR]=vmath.vector4(0,0,0,0),[DEPTH]=1})
        render.set_camera(WEAPON_CAMERA,{use_frustum=true})
        self.lighting.lighting_transform=inverse_view
        render.draw(self.weapon,{constants=self.lighting})
        for _,name in ipairs({"shadow_texture","environment_texture","albedo_texture","normal_texture","material_texture"}) do
            render.disable_texture(name)
        end

        -- Opt-in GPU qualification uses the actual scene/weapon targets and
        -- sampler states. The last stripe tests hardware alpha blending in HDR.
        if o.view=="hdr_probe" then
            render.set_render_target(t.scene)
            self.probe_constants.probe=vmath.vector4(0,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants)
            self.probe_constants.probe=vmath.vector4(1,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants,true)
            render.set_render_target(t.weapon)
            self.probe_constants.probe=vmath.vector4(2,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants)
        end

        local resolved_scene,resolved_weapon=t.scene,t.weapon
        self.temporal_draw_passes,self.weapon_aa_draw_passes=0,0
        if taa then
            if advance then
                local c=self.temporal_constants
                c.temporal_params=vmath.vector4(1/self.width,1/self.height,self.temporal.age>0 and 1 or 0,0)
                c.jitter=vmath.vector4(jx/self.width,jy/self.height,self.previous_jx or 0,self.previous_jy or 0)
                local rotation=vmath.matrix4(inverse_view)
                rotation.m03,rotation.m13,rotation.m23=0,0,0
                local old_rotation=vmath.matrix4(previous_view)
                old_rotation.m03,old_rotation.m13,old_rotation.m23=0,0,0
                c.sky_reprojection=previous_projection*old_rotation*rotation*vmath.inv(projection)
                bind("source_texture",t.scene)
                bind("history_texture",t.history_b)
                bind("depth_normal_texture",t.depth_normal)
                bind("previous_depth_texture",t.depth_previous)
                render.enable_texture("motion_texture",t.depth_normal,MOTION)
                render.enable_texture("expected_texture",t.depth_normal,EXPECTED)
                render.set_render_target(t.history_a)
                fullscreen(self,"temporal",c)
                if o.view=="motion" or o.view=="history" then
                    -- Reuse the idle weapon-AA target for raw diagnostics. Never
                    -- feed a diagnostic colour back into the radiance history.
                    render.set_render_target(t.weapon_aa)
                    c.temporal_params=vmath.vector4(1/self.width,1/self.height,self.temporal.age>0 and 1 or 0,o.view=="motion" and 1 or 2)
                    fullscreen(self,"temporal",c)
                end
                for _,name in ipairs({"source_texture","history_texture","depth_normal_texture","previous_depth_texture","motion_texture","expected_texture"}) do render.disable_texture(name) end
                t.history_a,t.history_b=t.history_b,t.history_a
                -- Allow camera/component transforms to settle after a reset before
                -- admitting any history. Both warmup frames resolve current colour only.
                if self.temporal.warmup>0 then self.temporal.warmup=self.temporal.warmup-1
                else self.temporal.age=self.temporal.age+1 end
                if self.temporal.age==temporal.capture_samples then self.report=true end
                self.temporal_draw_passes=(o.view=="motion" or o.view=="history") and 2 or 1
                self.previous_view,self.previous_jitter_projection=view,projection
                self.previous_jx,self.previous_jy=jx/self.width,jy/self.height
            end
            resolved_scene=(o.view=="motion" or o.view=="history") and t.weapon_aa or t.history_b
        else
            self.temporal.age=0
        end
        self.previous_inverse_view,self.previous_projection=inverse_view,unjittered
        if o.weapon_aa and o.view=="scene" then
            render.set_render_target(t.weapon_aa)
            self.aa_constants.aa_params=vmath.vector4(1/self.width,1/self.height,0,0)
            bind("source_texture",t.weapon)
            fullscreen(self,"weapon_aa",self.aa_constants)
            render.disable_texture("source_texture")
            resolved_weapon=t.weapon_aa
            self.weapon_aa_draw_passes=1
        end
        render.set_render_target(t.bloom_a)
        render.set_viewport(0,0,self.bloom_width,self.bloom_height)
        if o.bloom then
            bind("source_texture",resolved_scene)
            self.bloom_constants.bloom_step=vmath.vector4(1/self.bloom_width,0,1,0)
            fullscreen(self,"bloom",self.bloom_constants)
            render.set_render_target(t.bloom_b)
            bind("source_texture",t.bloom_a)
            self.bloom_constants.bloom_step=vmath.vector4(0,1/self.bloom_height,0,0)
            fullscreen(self,"bloom",self.bloom_constants)
            render.disable_texture("source_texture")
        else
            render.set_render_target(t.bloom_b)
            render.clear({[COLOR]=vmath.vector4()})
        end
        render.set_render_target(render.RENDER_TARGET_DEFAULT)
        render.set_viewport(0,0,self.width,self.height)
        self.post_constants.post=vmath.vector4(o.exposure,o.bloom and .12 or 0,(o.view=="cascades" or o.view=="shadow_visibility") and 0 or settings.views[o.view],o.atlas_half)
        self.post_constants.environment_debug=vmath.vector4(o.environment_level,0,0,0)
        local page=o.atlas_page-1
        self.post_constants.atlas_window=page<0 and vmath.vector4(0,0,1,1) or
            vmath.vector4((page%math.ceil(atlas.width/1024))*1024/atlas.width,
                math.floor(page/math.ceil(atlas.width/1024))*1024/atlas.height,1024/atlas.width,1024/atlas.height)
        bind("scene_texture",resolved_scene)
        bind("weapon_texture",resolved_weapon)
        bind("bloom_texture",t.bloom_b)
        bind("environment_texture",t.environment)
        bind("debug_texture",({albedo=t.albedo,normals=t.normal,material=t.material,shadow=t.shadow,depth=t.depth_normal,geometry_normals=t.depth_normal,ao=t.occlusion,contact=t.occlusion,occlusion_raw=t.occlusion_raw})[o.view] or t.albedo)
        fullscreen(self,nil,self.post_constants)
        for _,name in ipairs({"scene_texture","weapon_texture","bloom_texture","environment_texture","debug_texture"}) do
            render.disable_texture(name)
        end
    else
        render.set_render_target(render.RENDER_TARGET_DEFAULT)
        render.set_viewport(0,0,self.width,self.height)
        render.clear({[COLOR]=vmath.vector4(.08,.10,.13,1)})
    end
    render.set_camera()
    render.set_view(self.identity)
    render.set_projection(self.gui_projection)
    render.set_depth_mask(false)
    render.disable_state(G.STATE_DEPTH_TEST)
    render.disable_state(G.STATE_CULL_FACE)
    render.enable_state(G.STATE_BLEND)
    render.set_blend_func(G.BLEND_FACTOR_SRC_ALPHA,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.set_stencil_mask(0xff)
    render.clear({[G.BUFFER_TYPE_STENCIL_BIT]=0})
    render.enable_state(G.STATE_STENCIL_TEST)
    if not self.capture.active then
        render.draw(self.gui)
        render.draw(self.debug)
    end
    render.disable_state(G.STATE_STENCIL_TEST)
    render.disable_state(G.STATE_BLEND)
    report(self)
end
function on_message(self,id,message)
    if id==hash("renderer_reset_history") then
        temporal.reset(self.temporal,message.reason or "explicit")
        self.report=true
    elseif id==hash("capture_configure") then
        self.capture=message
        temporal.reset(self.temporal,"capture")
    elseif id==hash("renderer_configure") then
        self.options=settings.configure(self.options,message)
        temporal.reset(self.temporal,"settings")
        self.report=true
    elseif id==hash("renderer_volumes") then
        assert(#message.volumes<=daylight.max_volumes,"Indirect lighting volume budget exceeded")
        self.volume_count=#message.volumes
        for i=1,daylight.max_volumes do
            local volume=message.volumes[i] or {}
            for field_index,field in ipairs({"minimum","maximum","params","doorway","aperture"}) do
                local v=volume[field] or {0,0,0,0}
                self.lighting.volume_data[(i-1)*5+field_index]=vmath.vector4(v[1],v[2],v[3],v[4] or 0)
            end
        end
        self.report=true
    elseif id==hash("renderer_lights") then
        self.light_count=math.min(#message.lights,settings.max_lights)
        for i=1,settings.max_lights do
            local light=message.lights[i]
            self.lighting.light_positions[i]=light and light.position or vmath.vector4()
            self.lighting.light_colours[i]=light and light.colour or vmath.vector4()
            self.lighting.light_minimums[i]=light and light.minimum or vmath.vector4()
            self.lighting.light_maximums[i]=light and light.maximum or vmath.vector4()
        end
        self.report=true
    end
end
function final(self)
    render.set_listener(nil)
    for _,target in pairs(self.targets) do render.delete_render_target(target) end
    self.targets={}
end
