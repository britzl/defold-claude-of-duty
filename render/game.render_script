-- World -> isolated weapon colour/depth -> composite -> GUI. The weapon target
-- can stay outside future world fog and temporal effects without material hacks.
local G=graphics
local function resize(self)
    local w,h=render.get_window_width(),render.get_window_height()
    if w<=0 or h<=0 then return false end
    if w~=self.width or h~=self.height then
        self.width,self.height=w,h
        if self.weapon_target then render.set_render_target_size(self.weapon_target,w,h)
        else
            self.weapon_target=render.render_target({
                [G.BUFFER_TYPE_COLOR0_BIT]={format=G.TEXTURE_FORMAT_RGBA,width=w,height=h,
                    min_filter=G.TEXTURE_FILTER_LINEAR,mag_filter=G.TEXTURE_FILTER_LINEAR,
                    u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE},
                [G.BUFFER_TYPE_DEPTH_BIT]={format=G.TEXTURE_FORMAT_DEPTH,width=w,height=h}})
        end
        self.gui_projection=vmath.matrix4_orthographic(0,w,0,h,-1,1)
    end
    return true
end
function init(self)
    self.world=render.predicate({"model"})
    self.weapon=render.predicate({"viewmodel"})
    self.composite=render.predicate({"weapon_composite"})
    self.gui=render.predicate({"gui"})
    self.debug=render.predicate({"debug_text"})
    self.identity=vmath.matrix4()
    self.clear={ [G.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(.66,.74,.77,1),
        [G.BUFFER_TYPE_DEPTH_BIT]=1,[G.BUFFER_TYPE_STENCIL_BIT]=0 }
    resize(self)
end
function update(self)
    if not resize(self) then return end
    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.set_viewport(0,0,self.width,self.height)
    render.set_depth_mask(true)
    render.set_stencil_mask(0xff)
    render.disable_state(G.STATE_BLEND)
    render.enable_state(G.STATE_DEPTH_TEST)
    render.enable_state(G.STATE_CULL_FACE)
    render.set_depth_func(G.COMPARE_FUNC_LEQUAL)
    render.clear(self.clear)
    render.set_camera("main:/camera#camera",{use_frustum=true})
    render.draw(self.world)
    render.draw_debug3d()

    render.set_render_target(self.weapon_target)
    render.clear({[G.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(0,0,0,0),[G.BUFFER_TYPE_DEPTH_BIT]=1})
    render.set_camera("main:/viewmodel#camera",{use_frustum=true})
    render.draw(self.weapon)

    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.set_camera()
    render.set_view(self.identity)
    render.set_projection(self.identity)
    render.set_depth_mask(false)
    render.disable_state(G.STATE_DEPTH_TEST)
    render.disable_state(G.STATE_CULL_FACE)
    render.enable_state(G.STATE_BLEND)
    render.set_blend_func(G.BLEND_FACTOR_SRC_ALPHA,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_texture(0,self.weapon_target,G.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.composite)
    render.disable_texture(0)

    render.set_projection(self.gui_projection)
    render.enable_state(G.STATE_STENCIL_TEST)
    render.draw(self.gui)
    render.draw(self.debug)
    render.disable_state(G.STATE_STENCIL_TEST)
    render.disable_state(G.STATE_BLEND)
end
function final(self)
    if self.weapon_target then render.delete_render_target(self.weapon_target) end
end
