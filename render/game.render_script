        render.set_camera(WEAPON_CAMERA,{use_frustum=true})
        self.lighting.lighting_transform=inverse_view
        render.draw(self.weapon,{constants=self.lighting})
        local weapon_source=t.weapon
        if o.combat_effects and self.weapon_flash_active and photographic_view then
            -- The flash layer is linear on both backends. Resolve against the
            -- opaque weapon in shader, preserving encoded RGBA8 dark precision.
            -- Reuse idle transparency/AA targets; no additional target storage.
            render.set_render_target(t.glass)
            render.clear({[COLOR]=vmath.vector4()})
            render.set_depth_mask(false)
            render.disable_state(G.STATE_DEPTH_TEST)
            render.disable_state(G.STATE_CULL_FACE)
            render.enable_state(G.STATE_BLEND)
            render.set_blend_func(G.BLEND_FACTOR_ONE,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
            self.lighting.flash_screen=vmath.vector4(1/self.width,1/self.height,0,0)
            render.enable_texture("weapon_depth_texture",t.weapon,DEPTH)
            render.draw(self.weapon_flash,{constants=self.lighting,sort_order=render.SORT_BACK_TO_FRONT})
            render.disable_texture("weapon_depth_texture")
            render.disable_state(G.STATE_BLEND)
            render.set_render_target(t.weapon_aa)
            bind("source_texture",t.weapon);bind("flash_texture",t.glass)
            fullscreen(self,"weapon_composite",self.aa_constants)
            render.disable_texture("source_texture");render.disable_texture("flash_texture")
            weapon_source=t.weapon_aa
        end
        for _,name in ipairs({"shadow_texture","local_shadow_texture","environment_texture","albedo_texture","normal_texture","material_texture"}) do
            render.disable_texture(name)
        end

        -- Opt-in GPU qualification uses the actual scene/weapon targets and
        -- sampler states. The last stripe tests hardware alpha blending in HDR.
        if o.view=="hdr_probe" then
            render.set_render_target(t.scene)
            self.probe_constants.probe=vmath.vector4(0,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants)
            self.probe_constants.probe=vmath.vector4(1,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants,true)
            render.set_render_target(t.weapon)
            self.probe_constants.probe=vmath.vector4(2,0,0,0)
            fullscreen(self,"hdr_probe",self.probe_constants)
        end

        -- March only world air. Reflection replacement precedes fog; world TAA
        -- stabilizes both together. The independent weapon target stays clear.
        self.atmosphere_draw_passes=0
        local fog_debug=o.view=="fog_scatter" or o.view=="fog_transmittance"
        if (o.fog and (photographic_view or o.view=="motion" or o.view=="history")) or fog_debug then
            local c=self.fog_constants
            c.fog_inverse_view=inverse_view
            c.screen_projection=vmath.vector4(projection.m00,projection.m11,projection.m02,projection.m12)
            c.fog_screen=vmath.vector4(self.width,self.height,self.occlusion_width,self.occlusion_height)
            c.fog_options=vmath.vector4(o.volumetric_fog and 1 or 0,o.fog_shadows and 1 or 0,
                taa and (frozen and temporal.capture_samples-1 or self.temporal.age)%32 or 0,
                o.view=="fog_transmittance" and 2 or fog_debug and 1 or 0)
            c.shadow_data=data;c.features=self.lighting.features
            bind("depth_normal_texture",t.depth_normal);bind("sky_texture",t.sky)
            if o.volumetric_fog then
                render.set_render_target(t.fog_raw)
                render.set_viewport(0,0,self.occlusion_width,self.occlusion_height)
                bind("shadow_texture",t.shadow)
                fullscreen(self,"fog",c)
                render.disable_texture("shadow_texture")
                self.atmosphere_draw_passes=1
            end
            render.set_render_target(t.fog_scene)
            render.set_viewport(0,0,self.width,self.height)
            bind("source_texture",opaque_scene);bind("fog_texture",t.fog_raw)
            fullscreen(self,"fog_composite",c)
            for _,name in ipairs({"source_texture","fog_texture","depth_normal_texture","sky_texture"}) do render.disable_texture(name) end
            opaque_scene=t.fog_scene
            self.atmosphere_draw_passes=self.atmosphere_draw_passes+1
        end
        local resolved_scene,resolved_weapon=o.view=="hdr_probe" and t.scene or opaque_scene,weapon_source
        self.temporal_draw_passes,self.weapon_aa_draw_passes=0,0
        if taa then
            if advance then
                local c=self.temporal_constants
                c.temporal_params=vmath.vector4(1/self.width,1/self.height,self.temporal.age>0 and 1 or 0,0)
                c.jitter=vmath.vector4(jx/self.width,jy/self.height,self.previous_jx or 0,self.previous_jy or 0)
                local rotation=vmath.matrix4(inverse_view)
                rotation.m03,rotation.m13,rotation.m23=0,0,0
                local old_rotation=vmath.matrix4(previous_view)
                old_rotation.m03,old_rotation.m13,old_rotation.m23=0,0,0
                c.sky_reprojection=previous_projection*old_rotation*rotation*vmath.inv(projection)
                bind("source_texture",opaque_scene)
                bind("history_texture",t.history_b)
                bind("depth_normal_texture",t.depth_normal)
                bind("previous_depth_texture",t.depth_previous)
                render.enable_texture("motion_texture",t.depth_normal,MOTION)
                render.enable_texture("expected_texture",t.depth_normal,EXPECTED)
                render.set_render_target(t.history_a)
                fullscreen(self,"temporal",c)
                if o.view=="motion" or o.view=="history" then
                    -- Reuse the idle weapon-AA target for raw diagnostics. Never
                    -- feed a diagnostic colour back into the radiance history.
                    render.set_render_target(t.weapon_aa)
                    c.temporal_params=vmath.vector4(1/self.width,1/self.height,self.temporal.age>0 and 1 or 0,o.view=="motion" and 1 or 2)
                    fullscreen(self,"temporal",c)
                end
                for _,name in ipairs({"source_texture","history_texture","depth_normal_texture","previous_depth_texture","motion_texture","expected_texture"}) do render.disable_texture(name) end
                t.history_a,t.history_b=t.history_b,t.history_a
                -- Allow camera/component transforms to settle after a reset before
                -- admitting any history. Both warmup frames resolve current colour only.
                if self.temporal.warmup>0 then self.temporal.warmup=self.temporal.warmup-1
                else self.temporal.age=self.temporal.age+1 end
                if self.temporal.age==temporal.capture_samples then self.report=true end
                self.temporal_draw_passes=(o.view=="motion" or o.view=="history") and 2 or 1
                self.previous_view,self.previous_jitter_projection=view,projection
                self.previous_jx,self.previous_jy=jx/self.width,jy/self.height
            end
            resolved_scene=(o.view=="motion" or o.view=="history") and t.weapon_aa or t.history_b
        else
            self.temporal.age=0
        end
        self.previous_inverse_view,self.previous_projection=inverse_view,unjittered
        if o.weapon_aa and photographic_view then
            local output=weapon_source==t.weapon_aa and t.weapon or t.weapon_aa
            render.set_render_target(output)
            self.aa_constants.aa_params=vmath.vector4(1/self.width,1/self.height,0,0)
            bind("source_texture",weapon_source)
            fullscreen(self,"weapon_aa",self.aa_constants)
            render.disable_texture("source_texture")
            resolved_weapon=output
            self.weapon_aa_draw_passes=1
        end
        self.glass_draw_passes=0
        if (o.glass or o.combat_effects) and (photographic_view or o.view=="glass") then
            render.set_render_target(t.glass)
            render.set_viewport(0,0,self.width,self.height)
            render.clear({[COLOR]=vmath.vector4()})
            render.set_camera();render.set_view(view);render.set_projection(unjittered)
            render.set_depth_mask(false);render.disable_state(G.STATE_DEPTH_TEST);render.disable_state(G.STATE_CULL_FACE)
            render.enable_state(G.STATE_BLEND)
            render.set_blend_func(G.BLEND_FACTOR_ONE,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
            self.lighting.lighting_transform=self.identity
            self.lighting.glass_screen=vmath.vector4(1/self.width,1/self.height,jx/self.width,jy/self.height)
            bind("depth_normal_texture",t.depth_normal)
            for _,name in ipairs({"shadow","local_shadow","environment","albedo","normal","material"}) do bind(name.."_texture",t[name]) end
            -- A single submission sorts world glass, smoke, flashes and decals
            -- together. No transparent colour is ever admitted to TAA history.
            if self.capture.laboratory then
                local predicate=o.glass and o.combat_effects and self.transparent_lab or o.glass and self.glass_lab or self.combat_particle
                render.draw(predicate,{constants=self.lighting,frustum_planes=render.FRUSTUM_PLANES_ALL,frustum=unjittered*view,sort_order=render.SORT_BACK_TO_FRONT})
            else
                local predicate=o.glass and o.combat_effects and self.transparent or o.glass and self.glass or self.combat_particle
                render.draw(predicate,{constants=self.lighting,frustum_planes=render.FRUSTUM_PLANES_ALL,frustum=unjittered*view,sort_order=render.SORT_BACK_TO_FRONT})
            end
            for _,name in ipairs({"depth_normal_texture","shadow_texture","local_shadow_texture","environment_texture","albedo_texture","normal_texture","material_texture"}) do render.disable_texture(name) end
            render.set_render_target(t.glass_scene)
            bind("source_texture",resolved_scene);bind("glass_texture",t.glass)
            fullscreen(self,"glass_composite",self.aa_constants)
            render.disable_texture("source_texture");render.disable_texture("glass_texture")
            resolved_scene=o.view=="glass" and t.glass or t.glass_scene
            self.glass_draw_passes=2
        end
        self.haze_draw_passes=0
        if o.combat_effects and o.heat_distortion and photographic_view and (self.haze_count or 0)>0 then
            render.set_render_target(t.haze)
            render.set_viewport(0,0,self.occlusion_width,self.occlusion_height)
            render.clear({[COLOR]=vmath.vector4()})
            render.set_camera();render.set_view(view);render.set_projection(unjittered)
            render.set_depth_mask(false);render.disable_state(G.STATE_DEPTH_TEST);render.disable_state(G.STATE_CULL_FACE)
            render.enable_state(G.STATE_BLEND);render.set_blend_func(G.BLEND_FACTOR_ONE,G.BLEND_FACTOR_ONE)
            self.lighting.glass_screen=vmath.vector4(1/self.occlusion_width,1/self.occlusion_height,jx/self.width,jy/self.height)
            bind("depth_normal_texture",t.depth_normal)
            render.draw(self.combat_haze,{constants=self.lighting,frustum_planes=render.FRUSTUM_PLANES_ALL,frustum=unjittered*view})
            -- Reflected is no longer sampled after opaque/transparent resolve.
            render.set_render_target(t.reflected);render.set_viewport(0,0,self.width,self.height)
            bind("source_texture",resolved_scene);bind("haze_texture",t.haze)
            self.lighting.glass_screen=vmath.vector4(1/self.width,1/self.height,jx/self.width,jy/self.height)
            fullscreen(self,"haze_composite",self.lighting)
            for _,name in ipairs({"source_texture","haze_texture","depth_normal_texture"}) do render.disable_texture(name) end
            resolved_scene=t.reflected;self.haze_draw_passes=2
        end
        local rotation=vmath.matrix4(inverse_view)
        rotation.m03,rotation.m13,rotation.m23=0,0,0
        local old_rotation=vmath.matrix4(previous_view)
        old_rotation.m03,old_rotation.m13,old_rotation.m23=0,0,0
        local bloom
        resolved_scene,bloom=photo_pass.draw(self,resolved_scene,resolved_weapon,dt,{
            jx=jx/self.width,jy=jy/self.height,previous_jx=photo_previous_jx,previous_jy=photo_previous_jy,
            valid=photo_valid,sky=previous_projection*old_rotation*rotation*vmath.inv(projection)},fullscreen,bind)
        render.set_render_target(render.RENDER_TARGET_DEFAULT)
        render.set_viewport(0,0,self.output_width,self.output_height)
        self.post_constants.post=vmath.vector4(o.exposure,o.bloom and o.bloom_strength or 0,(o.view=="cascades" or o.view=="shadow_visibility") and 0 or settings.views[o.view],o.atlas_half)
        local treatment=o.view=="scene"
        self.post_constants.photo=vmath.vector4(treatment and o.grade_strength or 0,treatment and o.temporal_aa and o.sharpen or 0,
            treatment and o.vignette or 0,treatment and o.grain or 0)
        self.post_constants.photo_screen=vmath.vector4(1/self.width,1/self.height,self.capture.active and 0 or self.grain_time,0)
        self.post_constants.health=treatment and not self.capture.active and self.photo_state.health or vmath.vector4()
        self.post_constants.environment_debug=vmath.vector4(o.environment_level,0,0,0)
        local page=o.atlas_page-1
        self.post_constants.atlas_window=page<0 and vmath.vector4(0,0,1,1) or
            vmath.vector4((page%math.ceil(atlas.width/1024))*1024/atlas.width,
                math.floor(page/math.ceil(atlas.width/1024))*1024/atlas.height,1024/atlas.width,1024/atlas.height)
        bind("scene_texture",resolved_scene)
        bind("weapon_texture",resolved_weapon)
        bind("bloom_texture",o.view=="bloom" and o.bloom_level>0 and t["bloom_down_"..math.min(o.bloom_level,photographic.quality(o.photographic_quality).levels)] or bloom)
        bind("exposure_texture",t.exposure_b)
        bind("grade_texture",t.grade_lut)
        bind("environment_texture",t.environment)
        bind("debug_texture",({albedo=t.albedo,normals=t.normal,material=t.material,shadow=t.shadow,local_shadow=t.local_shadow,depth=t.depth_normal,geometry_normals=t.depth_normal,ao=t.occlusion,contact=t.occlusion,occlusion_raw=t.occlusion_raw})[o.view] or t.albedo)
        fullscreen(self,nil,self.post_constants)
        for _,name in ipairs({"scene_texture","weapon_texture","bloom_texture","environment_texture","debug_texture","exposure_texture","grade_texture"}) do
            render.disable_texture(name)
        end
    else
        render.set_render_target(render.RENDER_TARGET_DEFAULT)
        render.set_viewport(0,0,self.output_width,self.output_height)
        render.clear({[COLOR]=vmath.vector4(.08,.10,.13,1)})
    end
    render.set_camera()
    render.set_view(self.identity)
    render.set_projection(self.gui_projection)
    render.set_depth_mask(false)
    render.disable_state(G.STATE_DEPTH_TEST)
    render.disable_state(G.STATE_CULL_FACE)
    render.enable_state(G.STATE_BLEND)
    render.set_blend_func(G.BLEND_FACTOR_SRC_ALPHA,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.set_stencil_mask(0xff)
    render.clear({[G.BUFFER_TYPE_STENCIL_BIT]=0})
    render.enable_state(G.STATE_STENCIL_TEST)
    if not self.capture.active then
        render.draw(self.gui)
        render.draw(self.debug)
    end
    render.disable_state(G.STATE_STENCIL_TEST)
    render.disable_state(G.STATE_BLEND)
    report(self)
end
function on_message(self,id,message)
    if id==hash("renderer_world_ready") then
        self.shadow_cache_ready=true
        self.shadow_cached_fits=nil
        self.local_shadow_valid=false
    elseif id==hash("renderer_reset_history") then
        self.shadow_cached_fits=nil
        self.local_shadow_valid=false
        temporal.reset(self.temporal,message.reason or "explicit")
        self.exposure_valid=false
        self.report=true
    elseif id==hash("capture_configure") then
        self.shadow_cached_fits=nil
        self.local_shadow_valid=false
        self.capture=message
        if message.active then
            atmosphere.seek(self.weather,self.options.hour,self.options.weather_time)
        end
        self.exposure_valid=false
        temporal.reset(self.temporal,"capture")
    elseif id==hash("renderer_atmosphere_seek") then
        atmosphere.seek(self.weather,message.hour,message.time)
        self.report=true
    elseif id==hash("renderer_configure") then
        self.shadow_cached_fits=nil
        self.local_shadow_valid=false
        local next_options=settings.configure(self.options,message)
        atmosphere.configure(self.weather,self.options,next_options)
        local reallocate=next_options.photographic_quality~=self.options.photographic_quality or
            next_options.ads_dof~=self.options.ads_dof or next_options.motion_blur~=self.options.motion_blur
        self.options=next_options
        resize_shadows(self)
        if reallocate and self.width then photo_pass.resize(self,colour_target) end
        self.exposure_valid=false
        atmosphere_constants(self)
        temporal.reset(self.temporal,"settings")
        self.report=true
    elseif id==hash("renderer_combat_state") then
        self.haze_count=message.haze
    elseif id==hash("renderer_photographic_state") then
        self.photo_state=message
    elseif id==hash("renderer_volumes") then
        if message.count then
            assert(message.count>=0 and message.count<=daylight.max_volumes and message.count==math.floor(message.count),
                "Indirect lighting volume budget exceeded")
            self.volume_count=message.count
            for i=1,daylight.max_volumes*5 do self.lighting.volume_data[i]=vmath.vector4() end
        else
            local i,volume=message.index,message.volume
            assert(i and i>=1 and i<=self.volume_count and i==math.floor(i) and volume,"Invalid lighting volume slot")
            for field_index,field in ipairs({"minimum","maximum","params","doorway","aperture"}) do
                local v=volume[field] or {0,0,0,0}
                self.lighting.volume_data[(i-1)*5+field_index]=vmath.vector4(v[1],v[2],v[3],v[4] or 0)
            end
        end
        self.report=true
    elseif id==hash("renderer_weapon_flash") then
        self.weapon_flash_active=message.active
    elseif id==hash("renderer_flashes") then
        self.flash_positions,self.flash_colours=message.positions,message.colours
    elseif id==hash("renderer_lights") then
        local positions=message.shadow_positions or {vmath.vector4(),vmath.vector4()}
        if not local_lights.same_shadow_positions(positions,self.local_shadow_positions) then
            self.local_shadow_valid=false
            self.local_shadow_views=nil
        end
        self.local_shadow_positions=positions
        self.lighting.light_shadow_slots=message.shadow_slots or vmath.vector4(-1,0,-1,0)
        self.light_count=math.min(#message.lights,settings.max_lights)
        for i=1,settings.max_lights do
            local light=message.lights[i]
            self.lighting.light_positions[i]=light and light.position or vmath.vector4()
            self.lighting.light_colours[i]=light and light.colour or vmath.vector4()
            self.lighting.light_minimums[i]=light and light.minimum or vmath.vector4()
            self.lighting.light_maximums[i]=light and light.maximum or vmath.vector4()
        end
    end
end
function final(self)
    render.set_listener(nil)
    for _,target in pairs(self.targets) do render.delete_render_target(target) end
    self.targets={}
end
