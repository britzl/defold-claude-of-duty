-- Generated maps/sky -> sun shadows -> depth/normals -> AO/contact -> world
-- -> shadowed atmosphere -> temporal resolve -> isolated weapon AA -> photographic treatment -> tone mapping/grade -> GUI.
local settings=require "game.render.settings"
local atlas=require "game.render.surface_atlas"
local daylight=require "game.render.daylight"
local atmosphere=require "game.render.atmosphere"
local shadows=require "game.render.shadows"
local temporal=require "game.render.temporal"
local local_lights=require "game.render.local_lights"
local photographic=require "game.render.photographic"
local photo_pass=require "game.render.photographic_pass"
local combat_fx=require "game.render.combat_fx"
local G=graphics
local COLOR,DEPTH=G.BUFFER_TYPE_COLOR0_BIT,G.BUFFER_TYPE_DEPTH_BIT
local MOTION,EXPECTED=G.BUFFER_TYPE_COLOR1_BIT,G.BUFFER_TYPE_COLOR2_BIT
local WORLD_CAMERA="main:/camera#camera"
local WEAPON_CAMERA="main:/viewmodel#camera"
local function colour_target(w,h,depth,nearest,cube,format,surface_data,depth_texture)
    local params={ [COLOR]={format=format or G.TEXTURE_FORMAT_RGBA,width=w,height=h,
        min_filter=nearest and G.TEXTURE_FILTER_NEAREST or G.TEXTURE_FILTER_LINEAR,
        mag_filter=nearest and G.TEXTURE_FILTER_NEAREST or G.TEXTURE_FILTER_LINEAR,
        u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE} }
    if surface_data then
        for _,attachment in ipairs({MOTION,EXPECTED}) do
            params[attachment]={format=G.TEXTURE_FORMAT_RGBA,width=w,height=h,
                min_filter=G.TEXTURE_FILTER_NEAREST,mag_filter=G.TEXTURE_FILTER_NEAREST,
                u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE}
        end
    end
    if depth then params[DEPTH]={format=G.TEXTURE_FORMAT_DEPTH,width=w,height=h,flags=depth_texture and render.TEXTURE_BIT or nil} end
    if cube then params.type=G.TEXTURE_TYPE_CUBE_MAP end
    return render.render_target(params)
end
local function prepass_target(w,h)
    local params={}
    for _,attachment in ipairs({COLOR,MOTION,EXPECTED}) do
        params[attachment]={format=G.TEXTURE_FORMAT_RGBA,width=w,height=h,
            min_filter=G.TEXTURE_FILTER_NEAREST,mag_filter=G.TEXTURE_FILTER_NEAREST,
            u_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=G.TEXTURE_WRAP_CLAMP_TO_EDGE}
    end
    params[DEPTH]={format=G.TEXTURE_FORMAT_DEPTH,width=w,height=h}
    return render.render_target(params)
end
local function world_camera(self)
    render.set_camera()
    render.set_view(self.world_view)
    render.set_projection(self.world_projection)
end
local function resize(self)
    local w,h=render.get_window_width(),render.get_window_height()
    local d=settings.dimensions(w,h,self.options.render_scale)
    if d and (self.output_width~=w or self.output_height~=h) then
        self.output_width,self.output_height=w,h
        self.gui_projection=vmath.matrix4_orthographic(0,w,0,h,-1,1)
    end
    if not d then return false end
    if d.width~=self.width or d.height~=self.height then
        self.width,self.height=d.width,d.height
        self.bloom_width,self.bloom_height=d.bloom_width,d.bloom_height
        self.occlusion_width,self.occlusion_height=d.occlusion_width,d.occlusion_height
        if self.pipeline.backend=="opengl" then
            -- Defold 1.14 checks framebuffer completeness between attachment
            -- resizes. WebGL rejects the temporary mix of old/new dimensions.
            -- Recreate targets with depth/MRT attachments at their final size.
            for _,name in ipairs({"scene","weapon","depth_normal","depth_previous"}) do
                if self.targets[name] then
                    render.delete_render_target(self.targets[name]);self.targets[name]=nil
                end
            end
        end
        for _,name in ipairs({"scene","weapon","history_a","history_b","weapon_aa","reflected","glass","glass_scene","fog_scene","fog_raw"}) do
            local w,h=name=="fog_raw" and d.occlusion_width or d.width,name=="fog_raw" and d.occlusion_height or d.height
            if self.targets[name] then render.set_render_target_size(self.targets[name],w,h)
            else self.targets[name]=colour_target(w,h,name=="scene" or name=="weapon",name=="fog_raw",false,self.radiance_format,name=="scene",name=="weapon") end
        end
        for _,name in ipairs({"depth_normal","depth_previous","occlusion_raw","occlusion","haze"}) do
            local half=name=="occlusion_raw" or name=="haze"
            local w,h=half and d.occlusion_width or d.width,half and d.occlusion_height or d.height
            if self.targets[name] then render.set_render_target_size(self.targets[name],w,h)
            else self.targets[name]=(name=="depth_normal" or name=="depth_previous") and prepass_target(w,h) or colour_target(w,h,false,name~="haze") end
        end
        photo_pass.resize(self,colour_target)
        self.resizes=self.resizes+1
        temporal.reset(self.temporal,"resize")
        self.report=true
    end
    return true
end
local function resize_shadows(self)
    local size=self.options.shadow_resolution
    if self.shadow_size==size then return end
    for _,name in ipairs({"shadow","shadow_static_1","shadow_static_2","shadow_static_3","shadow_static_4"}) do
        if self.targets[name] then render.delete_render_target(self.targets[name]) end
        local n=name=="shadow" and size*2 or size
        self.targets[name]=colour_target(n,n,true,true,false,nil,false,name~="shadow")
    end
    self.shadow_size=size;self.shadow_cached_fits=nil;self.report=true
end
local function fullscreen(self,material,constants,blend,depth_copy)
    render.set_camera()
    render.set_view(self.identity)
    render.set_projection(self.identity)
    render.set_depth_mask(depth_copy==true)
    if depth_copy then
        render.enable_state(G.STATE_DEPTH_TEST)
        render.set_depth_func(G.COMPARE_FUNC_ALWAYS)
    else render.disable_state(G.STATE_DEPTH_TEST) end
    render.disable_state(G.STATE_CULL_FACE)
    render.disable_state(G.STATE_BLEND)
    if blend then
        render.enable_state(G.STATE_BLEND)
        render.set_blend_func(G.BLEND_FACTOR_SRC_ALPHA,G.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    end
    if material then render.enable_material(material) end
    render.draw(self.quad,{constants=constants})
    if material then render.disable_material() end
end
local function bind(name,target) render.enable_texture(name,target,COLOR) end
local function local_shadow_draw(self,material,predicate)
    render.set_view(self.identity)
    render.enable_material(material)
    local count=0
    for light,faces in ipairs(self.local_shadow_views) do
        for face,matrix in ipairs(faces) do
            local c=self.local_shadow_constants[(light-1)*6+face]
            c.sun_matrix=matrix;c.local_shadow_position=self.local_shadow_positions[light]
            render.set_viewport((face-1)%3*local_lights.shadow_size,
                (math.floor((face-1)/3)+(light-1)*2)*local_lights.shadow_size,local_lights.shadow_size,local_lights.shadow_size)
            render.set_projection(matrix)
            render.draw(predicate,{constants=c,frustum_planes=render.FRUSTUM_PLANES_ALL,frustum=matrix})
            count=count+1
        end
    end
    render.disable_material()
    return count
end
local function local_shadow_pass(self)
    local t,o=self.targets,self.options
    self.local_shadow_static_draw_passes,self.local_shadow_dynamic_draw_passes,self.local_shadow_copy_draw_passes=0,0,0
    local active=false
    for _,position in ipairs(self.local_shadow_positions) do if position.w>0 then active=true end end
    local enabled=o.local_lights and o.local_shadows and active
    local cached=enabled and o.local_shadow_cache and self.shadow_cache_ready
    if not cached then self.local_shadow_valid=false end
    if enabled and not self.local_shadow_views then
        self.local_shadow_views={}
        for i,position in ipairs(self.local_shadow_positions) do
            self.local_shadow_views[i]=position.w>0 and local_lights.faces(position) or {}
        end
    end
    local predicate=self.capture.laboratory and self.laboratory_shadow or self.world_shadow
    if cached and not self.local_shadow_valid then
        -- Rebuild the complete static atlas in one render pass. Preserving
        -- individual faces across target switches is unsafe on tile GPUs.
        render.set_render_target(t.local_shadow_static)
        render.set_viewport(0,0,local_lights.shadow_width,local_lights.shadow_height)
        render.clear({[COLOR]=vmath.vector4(1,0,0,1),[DEPTH]=1})
        self.local_shadow_static_draw_passes=local_shadow_draw(self,"local_shadow",predicate)
        self.local_shadow_valid=true
        self.local_shadow_cache_refreshes=(self.local_shadow_cache_refreshes or 0)+1
    end
    render.set_render_target(t.local_shadow)
    render.set_viewport(0,0,local_lights.shadow_width,local_lights.shadow_height)
    render.clear({[COLOR]=vmath.vector4(1,0,0,1),[DEPTH]=1})
    if enabled then
        if cached then
            bind("source_texture",t.local_shadow_static)
            render.enable_texture("source_depth",t.local_shadow_static,DEPTH)
            fullscreen(self,"shadow_copy",nil,false,true)
            render.disable_texture("source_texture");render.disable_texture("source_depth")
            self.local_shadow_copy_draw_passes=1
            render.enable_state(G.STATE_CULL_FACE)
            render.set_depth_func(G.COMPARE_FUNC_LEQUAL)
        else
            self.local_shadow_static_draw_passes=local_shadow_draw(self,"local_shadow",predicate)
        end
        if not self.capture.active or self.capture.actors then
            self.local_shadow_dynamic_draw_passes=local_shadow_draw(self,"local_shadow_skinned",self.soldier_shadow)
        end
    end
    self.local_shadow_draw_passes=self.local_shadow_static_draw_passes+self.local_shadow_dynamic_draw_passes
end
local function bake_scratch(self)
    self.targets.atlas_spare=colour_target(atlas.width,atlas.height)
    self.targets.scratch_a=colour_target(atlas.scratch_size,atlas.scratch_size)
    self.targets.scratch_b=colour_target(atlas.scratch_size,atlas.scratch_size)
end
local function release_bake_scratch(self)
    for _,name in ipairs({"atlas_spare","scratch_a","scratch_b"}) do
        render.delete_render_target(self.targets[name]);self.targets[name]=nil
    end
end
local function set_atmosphere(constants,rig,options,time)
    local values=daylight.constants(vmath.vector4,rig,options.clouds)
    values.daylight_data[7]=atmosphere.weather(vmath.vector4,time,options)
    for name,value in pairs(values) do constants[name]=value end
end
local function atmosphere_constants(self)
    self.rig=self.weather.rig
    for _,constants in ipairs({self.lighting,self.sky_constants,self.post_constants,self.reflection_constants,self.fog_constants}) do
        set_atmosphere(constants,self.rig,{clouds=self.weather.clouds,cloud_shadows=self.options.cloud_shadows},self.weather.shown_time)
    end
end
local function bind_scattering(target)
    render.enable_texture("scattering_texture",target,MOTION)
    render.enable_texture("scattering_fine_texture",target,EXPECTED)
end
local function unbind_scattering()
    render.disable_texture("scattering_texture")
    render.disable_texture("scattering_fine_texture")
end
local function atmosphere_copy(self,target,source,w,h,next_target,blend,environment)
    render.set_render_target(target)
    render.set_viewport(0,0,w,h)
    bind("source_texture",source);bind("next_texture",next_target or source)
    self.mix_constants.atmosphere_mix=vmath.vector4(blend or 0,next_target and 0 or 1,environment and 1 or 0,
        (daylight.environment_rows-1)/daylight.environment_rows)
    fullscreen(self,"atmosphere_mix",self.mix_constants)
    render.disable_texture("source_texture");render.disable_texture("next_texture")
    self.weather_draws=self.weather_draws+1
end
local function bake_environment(self)
    -- Initial loading/context rebakes complete both targets before world draws.
    -- Runtime changes use the staged path below.
    set_atmosphere(self.bake_constants,self.weather.rig,self.options,self.weather.shown_time)
    -- Borrow a staging target for the one invariant BRDF tile. Its format
    -- matches the atlas; no extra target or surface sampler is needed.
    render.set_render_target(self.targets.environment_pending)
    local stride=daylight.environment_stride
    render.set_viewport(0,(daylight.environment_rows-1)*stride,stride,stride)
    fullscreen(self,"environment_brdf",self.bake_constants)
    self.bake_constants.scattering_size=vmath.vector4(daylight.sky_width,daylight.sky_height,1/daylight.sky_width,1/daylight.sky_height)
    self.bake_constants.bake_region=vmath.vector4(0,1,0,0)
    render.set_render_target(self.targets.sky_pending)
    render.set_viewport(0,0,daylight.sky_width,daylight.sky_height)
    bind_scattering(self.targets.sky_scratch)
    fullscreen(self,"atmosphere",self.bake_constants)
    unbind_scattering()
    self.scattering_rig=self.weather.rig
    self.scattering_updates=self.scattering_updates+1
    atmosphere_copy(self,self.targets.sky,self.targets.sky_pending,daylight.sky_width,daylight.sky_height)
    render.set_render_target(self.targets.environment)
    render.set_viewport(0,0,daylight.environment_width,daylight.environment_height)
    bind("sky_texture",self.targets.sky)
    bind("brdf_texture",self.targets.environment_pending)
    fullscreen(self,"environment",self.bake_constants)
    render.disable_texture("sky_texture")
    render.disable_texture("brdf_texture")
    self.environment_updates=self.environment_updates+1
    self.environment_dirty=false
    self.report=true
end
local function animate_atmosphere(self,dt)
    local s,t=self.weather,self.targets
    self.weather_draws=0
    self.scattering_draws=0
    local forced=s.forced
    local phase,index,committed=atmosphere.step(s,self.options,dt,self.photo_state.paused or not self.shadow_cache_ready,self.capture.active)
    if not phase then return end
    if phase=="begin" then
        -- Hold the current complete pair while the new pair is built in strips.
        for _,name in ipairs({"sky","environment"}) do
            local w,h=name=="sky" and daylight.sky_width or daylight.environment_width,name=="sky" and daylight.sky_height or daylight.environment_height
            atmosphere_copy(self,t[name.."_previous"],t[name],w,h)
        end
        set_atmosphere(self.bake_constants,s.pending,self.options,s.pending_time)
        self.scattering_reuse=atmosphere.same_scattering(self.scattering_rig,s.pending)
        -- Invalidate before overwriting any strips. A seek may interrupt this
        -- bake and return to the old hour while the cache contains mixed rows.
        if not self.scattering_reuse then self.scattering_rig=nil end
    elseif phase=="sky" or phase=="environment" then
        local count=phase=="sky" and atmosphere.sky_slices or atmosphere.environment_slices
        local w,h=phase=="sky" and daylight.sky_width or daylight.environment_width,phase=="sky" and daylight.sky_height or daylight.environment_height
        local pending,scratch=phase.."_pending",phase.."_scratch"
        -- A complete preservation draw and one strip share a render pass;
        -- Metal's DONT_CARE load action cannot discard earlier strips.
        if phase=="sky" then
            render.set_render_target(t[scratch])
            render.set_viewport(0,0,w,h)
            bind("source_texture",t[pending]);bind_scattering(t[pending])
            fullscreen(self,"atmosphere_copy")
            render.disable_texture("source_texture");unbind_scattering()
            self.weather_draws=self.weather_draws+1
        else
            atmosphere_copy(self,t[scratch],index==1 and t[phase.."_previous"] or t[pending],w,h)
        end
        -- Environment updates skip the static final row, retaining atlas pitch.
        local rows=phase=="sky" and count or daylight.environment_rows
        render.set_viewport(0,(index-1)*h/rows,w,h/rows)
        self.bake_constants.bake_region=vmath.vector4((index-1)/rows,1/rows,self.scattering_reuse and 1 or 0,0)
        if phase=="environment" then bind("sky_texture",t.sky_pending);bind("brdf_texture",t.environment_previous)
        else bind_scattering(t[pending]) end
        fullscreen(self,phase=="sky" and "atmosphere" or "environment",self.bake_constants)
        if phase=="environment" then render.disable_texture("sky_texture");render.disable_texture("brdf_texture")
        else
            unbind_scattering()
            self.scattering_draws=self.scattering_reuse and 0 or 1
            if index==count then
                self.scattering_rig=s.pending
                if not self.scattering_reuse then self.scattering_updates=self.scattering_updates+1 end
            end
        end
        t[pending],t[scratch]=t[scratch],t[pending]
        self.weather_draws=self.weather_draws+1
    else
        for _,name in ipairs({"sky","environment"}) do
            local w,h=name=="sky" and daylight.sky_width or daylight.environment_width,name=="sky" and daylight.sky_height or daylight.environment_height
            -- At an endpoint copy raw values to retain exact RGBA8 pixels.
            atmosphere_copy(self,t[name],committed and t[name.."_pending"] or t[name.."_previous"],w,h,
                not committed and t[name.."_pending"] or nil,index,name=="environment")
        end
        atmosphere_constants(self)
        if committed then
            self.environment_updates=self.environment_updates+1
            if forced then temporal.reset(self.temporal,"atmosphere_seek");self.exposure_valid=false end
        end
    end
    self.report=true
end
-- Defold 1.14 has 1024 render-script commands per update. Reserve 128 for
-- the loading screen/HUD; scene rendering starts in the following update.
local BAKE_COMMAND_BUDGET=896
local function bake_job_commands(job)
    -- fullscreen() emits ten commands. Include target/viewport and texture
    -- bindings; atlas patches also issue a complete preservation pass.
    if not job then return 60 end -- one BRDF tile + sky/cache + publication copy + environment
    if job.op=="recipe" then return 12 end
    return (job.target=="scratch_a" or job.target=="scratch_b") and 16 or 32
end
local function bake_next(self)
    local commands=0
    if self.bake_step==0 then
        if not self.targets.scratch_a then bake_scratch(self) end
        for _,name in ipairs({"albedo","normal","material"}) do
            render.set_render_target(self.targets[name])
            render.clear({[COLOR]=vmath.vector4()})
        end
        commands=6
    end
    while self.bake_step<atlas.job_count do
        local job=self.bake_jobs[self.bake_step+1]
        local cost=bake_job_commands(job)
        if commands+cost>BAKE_COMMAND_BUDGET then break end
        commands=commands+cost
        if job then
            if job.target~="scratch_a" and job.target~="scratch_b" then
                -- Defold 1.14 Lua targets use DONT_CARE load operations. On
                -- tile GPUs a partial viewport discards neighbouring pixels.
                -- Copy the complete old atlas to a spare, then patch it in the
                -- SAME render pass. Swap ownership; never sample the target.
                local previous=self.targets[job.target]
                render.set_render_target(self.targets.atlas_spare)
                render.set_viewport(0,0,atlas.width,atlas.height)
                self.bake_constants.filter_params=vmath.vector4(0,3,0,0)
                bind("source_texture",previous)
                bind("height_texture",self.targets.scratch_b)
                fullscreen(self,"surface_filter",self.bake_constants)
                render.disable_texture("source_texture")
                render.disable_texture("height_texture")
                self.targets[job.target],self.targets.atlas_spare=self.targets.atlas_spare,previous
                self.bake_draws=self.bake_draws+1
            end
            render.set_render_target(self.targets[job.target])
            if job.op=="recipe" then
                render.set_viewport(0,0,job.size,job.size)
                self.bake_constants.bake=vmath.vector4(job.channel,job.kind,job.size,0)
                fullscreen(self,"bake",self.bake_constants)
            else
                local r,src=job.rect,job.source_rect
                render.set_viewport(r.x,r.y,r.size+2,r.size+2)
                self.bake_constants.source_rect=vmath.vector4(src.x/job.source_width,src.y/job.source_height,
                    src.size/job.source_width,src.size/job.source_height)
                self.bake_constants.filter_params=vmath.vector4(r.size,job.op=="normal" and (job.foliage and 4 or 2) or job.op=="reduce" and 1 or 0,
                    job.relief or 0,src.size)
                bind("source_texture",self.targets[job.source])
                bind("height_texture",self.targets.scratch_b)
                fullscreen(self,"surface_filter",self.bake_constants)
                render.disable_texture("source_texture")
                render.disable_texture("height_texture")
            end
        else
            bake_environment(self)
        end
        self.bake_step=self.bake_step+1
        self.bake_draws=self.bake_draws+1
        self.report=true
    end
    self.bake_frames=self.bake_frames+1
    self.bake_peak_commands=math.max(self.bake_peak_commands,commands)
end
local function report(self)
