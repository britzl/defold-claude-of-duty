local runtime = require "game.runtime"
local input = require "game.input"
local combat = require "game.combat"
local config = require "game.config"
local world_adapter = require "game.world.defold"
local capsule_queries = require "game.player.bullet"
local player_system = require "game.systems.player"
local player_health = require "game.player.health"
local health_tuning = require "game.player.health_tuning"
local driver = require "game.player.driver"
local course = require "game.player.course"
local weapon_system = require "game.systems.weapons"
local weapon_adapter = require "game.weapons.defold"
local combat_fx = require "game.render.combat_fx_defold"
local weapon_driver = require "game.weapons.driver"
local firing_range = require "game.weapons.range"
local ai_system = require "game.systems.ai"
local soldier_adapter = require "game.ai.defold"
local renderer_settings = require "game.render.settings"
local capture_controller = require "game.render.capture_controller"
local capture_shots = require "game.render.capture"
local audio_system = require "game.systems.audio"
local audio_adapter = require "game.audio.defold"
local ui = require "game.ui.controller"
local ui_controls = require "game.ui.controls"
local hud_model = require "game.ui.hud"
local hud_feedback = require "game.ui.feedback"
local touch = require "game.touch"
local dynamics = require "game.physics.defold"
local grenades = require "game.systems.grenades"

local actions = {}
for _, name in ipairs(input.actions) do actions[hash(name)] = name end
local APPLY_DAMAGE = hash("apply_damage")
local HUD_STATE = hash("hud_state")
local VIEW_ACTIONS = { [hash("view_street")] = "street", [hash("view_shop")] = "shop", [hash("view_room")] = "room" }
local PLAY, ESCAPE, COURSE = hash("play"), hash("release_mouse"), hash("course")
local TOUCH, TOUCH_SOURCE = hash("touch_multi"), hash("touch")
local IS_HTML5 = sys.get_sys_info().system_name == "HTML5"
local handle_input

local function select_view(self, name)
    msg.post("@render:","renderer_reset_history",{reason="view"})
    self.view = name
    self.ctx.player.enabled = not name
    self.ctx.player.drive = nil
    self.weapon_drive = nil
    input.reset(self.ctx.input)
    if self.touch then touch.reset(self.touch,self.ctx.input) end
    window.set_mouse_lock(false)
end

local function create_course(self)
    assert(self.ctx.world.ready, "World is still loading")
    if not self.course then self.course = course.create() end
end

local function create_range(self)
    assert(self.ctx.world.ready, "World is still loading")
    if not self.range then
        self.range = firing_range.new(self.ctx)
        self.bullet_registries[#self.bullet_registries+1] = self.range.adapter.by_id
    end
end

local function restart_encounter(self)
    msg.post("@render:","renderer_reset_history",{reason="restart"})
    capture_controller.finish(self)
    self.suppression_validation=nil
    audio_system.reset(self.ctx)
    select_view(self,nil)
    combat.remove(self.ctx.combat,"player")
    self.ctx.player.actor=combat.register(self.ctx.combat,"player",config.player_health,health_tuning.regeneration)
    player_health.reset(self.ctx)
    player_system.reset(self.ctx,self.ctx.world.spawn,0)
    weapon_system.init(self.ctx)
    combat_fx.reset(self.combat_visuals)
    weapon_adapter.reset(self.weapon_visuals)
    grenades.reset(self.ctx)
    dynamics.reset(self.ctx.services.dynamics)
    self.ctx.ai.enabled=true
    self.ctx.ai.damage_scale=1
    ai_system.reset(self.ctx)
    self.ctx.fx.hitmarker,self.ctx.fx.damage_flash=0,0
    self.ctx.fx.flashes={}
    self.active_lights=nil
    hud_model.reset(self.ctx)
end

local function world_snapshot(world)
    return { ready = world.ready, phase = world.phase, seed = world.seed,
        mesh_backend=world.mesh_backend, mesh_verified=world.verify_mesh or false,
        timings=world.timings,
        boxes = world.stats.boxes, vertices = world.stats.vertices, mesh_bytes = world.stats.mesh_bytes,
        batches = world.stats.batches, colliders = world.stats.colliders,
        navigation_nodes = #world.navigation.nodes, navigation_edges = #world.navigation.edges,
        cover_candidates = #world.cover, spawn_points = #world.spawn_points,
        work_ms = world.work_seconds * 1000, peak_job_ms = world.peak_job_seconds * 1000 }
end

local function snapshot(ctx)
    local motion = ctx.player.motion
    return {
        tick = ctx.time.tick, elapsed = ctx.time.elapsed,
        frame = ctx.time.frame, frame_elapsed = ctx.time.frame_elapsed,
        fixed_dt = ctx.time.fixed_dt, alpha = ctx.time.alpha,
        health = ctx.player.actor.health, alive = ctx.player.actor.alive,
        recovery = player_health.snapshot(ctx),
        move_x = ctx.player.intent.move_x, move_z = ctx.player.intent.move_z,
        physics = sys.get_config_string("physics.type"),
        gravity = sys.get_config_number("physics.gravity_y"),
        physics_scale = sys.get_config_number("physics.scale"),
        x = ctx.player.position.x, y = ctx.player.position.y, z = ctx.player.position.z,
        vx = motion.velocity.x, vy = motion.velocity.y, vz = motion.velocity.z,
        grounded = motion.grounded, stance = motion.stance, height = motion.height,
        yaw = motion.yaw, pitch = motion.pitch, recovery_failed = motion.recovery_failed,
        mouse_locked = window.get_mouse_lock(),
        paused = ctx.paused,
        sliding = motion.sliding, tactical = motion.tactical, mantling = motion.mantle ~= false,
        lean = motion.lean, slide_cooldown = motion.slide_cooldown, tactical_cooldown = motion.tactical_cooldown,
        camera_x = ctx.presentation.camera.x, camera_y = ctx.presentation.camera.y, camera_z = ctx.presentation.camera.z,
        camera_roll = ctx.presentation.roll or 0,
        camera_pitch = ctx.presentation.pitch, camera_yaw = ctx.presentation.yaw,
        camera_fov = ctx.presentation.fov,
        vaulting = motion.mantle and motion.mantle.kind == "vault" or false,
    }
end

local function window_event(self, event)
    if event == window.WINDOW_EVENT_FOCUS_LOST then
        ui.focus(self, false)
    elseif event == window.WINDOW_EVENT_FOCUS_GAINED then
        ui.focus(self, true)
    end
end

function init(self)
    assert(sys.get_config_int("engine.fixed_update_frequency") == config.fixed_frequency,
        "game.project and game.config must agree on the fixed update frequency")
    assert(math.abs(sys.get_config_number("physics.gravity_y") - config.gravity) < 0.00001,
        "game.project and game.config must agree on gravity")
    assert(sys.get_config_string("physics.type") == "3D"
        and sys.get_config_number("physics.scale") == 1
        and sys.get_config_boolean("physics.use_fixed_timestep"),
        "Gameplay requires metre-based 3D physics with a fixed timestep")
    -- The profiler API is absent in release engines. Profiling must never gate startup.
    if profiler then profiler.scope_begin("loading.init.runtime") end
    self.ctx = runtime.new({ world = world_adapter.new("#world_mesh", "#world_collision"),
        audio = audio_adapter.new("#audio_voice","#audio_loop") })
    if profiler then profiler.scope_end() end
    self.renderer_settings = renderer_settings.defaults()
    self.renderer_stats = { ready = false }
    if profiler then profiler.scope_begin("loading.init.combat_fx") end
    self.combat_visuals=combat_fx.new(self.ctx)
    if profiler then profiler.scope_end() end
    if profiler then profiler.scope_begin("loading.init.weapons") end
    self.weapon_visuals = weapon_adapter.new(self.ctx, "#weapon_mesh", "#weapon_effect")
    if profiler then profiler.scope_end() end
    if profiler then profiler.scope_begin("loading.init.soldiers") end
    self.ctx.services.soldiers=soldier_adapter.new(self.ctx,self.ctx.world.adapter,"#soldier_mesh","#soldier_mover","#soldier_hit")
    self.ctx.services.dynamics=dynamics.new(self.ctx)
    if profiler then profiler.scope_end() end
    if sys.get_config_int("world_mesh.verify",0)==1 then require("tests.native_mesh_test").run() end
    if sys.get_config_int("audio_synthesis.verify",0)==1 then require("tests.native_audio_test").run() end
    if sys.get_config_int("mesh_validation.enabled",0)==1 then self.mesh_validation=require("tests.mesh_browser").new() end
    if sys.get_config_int("audio_content_validation.enabled",0)==1 then self.audio_content_validation=require("tests.audio_content_scenario").new() end
    if sys.get_config_int("hud_validation.enabled",0)==1 then self.hud_validation=require("tests.hud_scenario").new() end
    if sys.get_config_int("audio_validation.enabled",0)==1 then self.audio_validation={} end
    self.bullet_registries = { self.ctx.world.adapter.by_id, self.ctx.services.soldiers.by_id, self.ctx.services.dynamics.by_id }
    self.ctx.services.bullets = weapon_adapter.query(self.bullet_registries)
    self.ctx.services.enemy_bullets=weapon_adapter.query({self.ctx.world.adapter.by_id,self.ctx.services.dynamics.by_id},
        {groups={hash("world"),hash("player"),hash("debris")},actors={[hash("/player")]="player"}})
    if sys.get_sys_info().system_name=="HTML5" and sys.get_config_int("squad_validation.enabled",0)==1 then
        self.squad_validation=require("tests.squads_browser").new()
    end
    if sys.get_config_int("suppression_validation.enabled",0)==1 then
        self.suppression_validation=require("tests.suppression_scenario").new()
    end
    if sys.get_config_int("rendering_validation.enabled",0)==1 then
        self.rendering_validation=require("tests.rendering_browser").new()
    end
    if sys.get_config_int("market_validation.enabled",0)==1 then
        self.market_validation=require("tests.market_browser").new()
    end
    if sys.get_config_int("traversal_validation.enabled",0)==1 then
        self.traversal_validation=require("tests.traversal_scenario").new()
    end
    if sys.get_config_int("viewmodel_validation.enabled",0)==1 then
        self.viewmodel_validation=require("tests.viewmodel_scenario").new()
    end
    if sys.get_config_int("health_validation.enabled",0)==1 then
        self.health_validation=require("tests.health_scenario").new()
    end
    if sys.get_config_int("soldier_validation.enabled",0)==1 then
        self.soldier_validation=require("tests.soldier_scenario").new()
    end
    if sys.get_config_int("animated_atmosphere_validation.enabled",0)==1 then self.animated_atmosphere_validation=require("tests.animated_atmosphere_scenario").new() end
    if sys.get_config_int("effects_validation.enabled",0)==1 then self.effects_validation=require("tests.effects_scenario").new() end
    if sys.get_config_int("grenades_validation.enabled",0)==1 then
        self.grenades_validation=require("tests.grenades_scenario").new()
    end
    if sys.get_config_int("ai_tactics_validation.enabled",0)==1 then
        self.ai_tactics_validation=require("tests.ai_tactics_scenario").new()
    end
    if sys.get_config_int("physics_validation.enabled",0)==1 then
        self.physics_validation=require("tests.physics_scenario").new()
    end
    if sys.get_config_int("ballistics_validation.enabled",0)==1 then
        self.ballistics_validation=require("tests.ballistics_scenario").new()
    end
    self.view = nil
    self.position = vmath.vector3()
    self.camera_position = vmath.vector3()
    ui.init(self, restart_encounter)
    if sys.get_config_int("touch_validation.enabled",0)==1 then
        require("tests.touch_native").install(self,handle_input)
    end
    msg.post(".", "acquire_input_focus")
    window.set_listener(window_event)
    if automation_bridge then
        capture_controller.install(self)
        automation_bridge.command("audio.snapshot",function() return audio_system.snapshot(self.ctx) end)
        automation_bridge.command("audio.configure",function(data)
            local result=audio_system.configure(self.ctx,data)
            ui.publish(self)
            return result
        end)
        automation_bridge.command("audio.preview",function(data) return audio_system.preview(self.ctx,data) end)
        automation_bridge.describe("command","audio.snapshot",{description="Read generated sound bank, bounded voices, event counts, listener room and actual mixer peaks.",output_schema={type="object"}})
        automation_bridge.describe("command","audio.configure",{description="Set master/weapons/foley/ambience gains 0..1 or muted boolean.",input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.describe("command","audio.preview",{description="Audition kind shot with weapon rifle/smg/pistol, or kind impact/step with surface; optional world position {x,y,z}. Uses the normal bounded playback path.",input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.command("renderer.snapshot",function() return self.renderer_stats end)
        automation_bridge.command("renderer.configure",function(data)
            self.renderer_settings=renderer_settings.configure(self.renderer_settings,data)
            msg.post("@render:","renderer_configure",self.renderer_settings)
            -- An explicit address must work even when it equals the original
            -- setting but the live clock has since advanced.
            if data.hour~=nil or data.lighting~=nil or data.weather_time~=nil then
                msg.post("@render:","renderer_atmosphere_seek",{
                    hour=(data.hour~=nil or data.lighting~=nil) and self.renderer_settings.hour or nil,
                    time=data.weather_time})
            end
            ui.publish(self)
            return self.renderer_settings
        end)
        automation_bridge.describe("command","renderer.snapshot",{
            description="Read GPU bake progress, target sizes/budget, shadow frames and active renderer settings.",
            output_schema={type="object"}})
        automation_bridge.describe("command","renderer.configure",{
            description="Set lighting daylight/sunset/night, hour 0..24, time_rate -1..1 hours/second, weather_speed 0..10, weather_time 0..86400 seconds, cloud_shadows boolean, clouds/volumetric_fog/fog_shadows/temporal_aa/weapon_aa/ambient_occlusion/contact_shadows/shadows/normal_maps/local_lights/fog/bloom/weathering/micro_detail/parallax/interior_lighting/environment_filter booleans, exposure 0.25..4, or view scene/albedo/normals/material/shadow/environment/environment_atlas/hdr_probe; environment_level 0..7. Presentation only.",
            input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.command("ai.snapshot",function() return ai_system.snapshot(self.ctx) end)
        automation_bridge.command("ai.validate_suppression",function()
            assert(self.ctx.world.ready,"World is still loading")
            self.suppression_validation=require("tests.suppression_scenario").new()
            return {phase=self.suppression_validation.phase}
        end)
        automation_bridge.command("ai.suppression_result",function()
            assert(self.suppression_validation,"No suppression scenario started")
            return self.suppression_validation
        end)
        automation_bridge.command("ai.configure",function(data)
            assert(data.enabled~=nil or data.damage_scale~=nil,"Expected enabled or damage_scale")
            if data.enabled~=nil then
                assert(type(data.enabled)=="boolean","enabled must be a boolean")
                self.ctx.ai.enabled=data.enabled
            end
            if data.damage_scale~=nil then
                assert(type(data.damage_scale)=="number" and data.damage_scale>=0 and data.damage_scale<=1,"Invalid damage_scale")
                self.ctx.ai.damage_scale=data.damage_scale
            end
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("ai.reset",function(data)
            assert(self.ctx.world.ready,"World is still loading")
            if data.position then
                for _,key in ipairs({"x","y","z"}) do
                    local v=data.position[key]
                    assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid position")
                end
            end
            local yaw=data.yaw or math.pi
            assert(type(yaw)=="number" and yaw==yaw and math.abs(yaw)<10000,"Invalid yaw")
            ai_system.reset(self.ctx,data.position,yaw)
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("ai.volumes",function()
            local result={}
            for _,shape in pairs(self.ctx.services.soldiers.by_id) do
                if not shape.disabled then result[#result+1]={id=shape.id,actor=shape.actor,x=shape.x,y=shape.y,z=shape.z,
                    headshot=shape.headshot or false,region=shape.region,part=shape.part,damage_scale=shape.damage_scale} end
            end
            return result
        end)
        automation_bridge.command("ai.route",function(data)
            local e=self.ctx.ai.actors[data.id or "enemy_1"]
            assert(e and e.actor.alive,"No living soldier")
            local q=soldier_adapter.query(self.ctx.services.soldiers,e)
            assert(q,"Soldier physics is settling")
            local target=data.target
            assert(type(target)=="table","Missing target")
            for _,key in ipairs({"x","y","z"}) do
                local v=target[key]
                assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid target")
            end
            return {points=require("game.ai.navigation").route(self.ctx.world.navigation,e.position,target,q) or {}}
        end)
        automation_bridge.command("ai.patrol",function(data)
            local e=self.ctx.ai.actors[data.id or "enemy_1"]
            assert(e and e.actor.alive,"No living soldier")
            assert(type(data.points)=="table" and #data.points>0 and #data.points<=8,"Expected 1-8 patrol points")
            local points={}
            for i,p in ipairs(data.points) do
                for _,key in ipairs({"x","y","z"}) do
                    local v=p[key]
                    assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid patrol point")
                end
                points[i]={x=p.x,y=p.y,z=p.z}
            end
            require("game.ai.tactics").release(self.ctx.ai,e)
            e.nav_job=nil
            require("game.ai.perception").clear(e)
            e.patrol_points=points;e.patrol=1;e.route=nil;e.route_goal=nil;e.memory=0;e.notice=0;e.think=0
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("gameplay.restart",function()
            assert(self.ctx.world.ready,"World is still loading")
            restart_encounter(self)
            return snapshot(self.ctx)
        end)
        for name,description in pairs({
            ["ai.snapshot"]="Read actors, suppression/crouch/peek state, squad reports, cover/flank claims, shots and costs.",
            ["ai.validate_suppression"]="Start the opt-in real-projectile suppression and cover recovery validation scenario.",
            ["ai.suppression_result"]="Read the active suppression validation phase and completed assertions.",
            ["ai.configure"]="Set enabled boolean and/or damage_scale 0..1 for repeatable combat profiles; frozen soldiers remain shootable.",
            ["ai.reset"]="Reset both squads; an explicit {position={x,y,z},yaw} creates a single test soldier. Preserves AI pause and damage scale.",
            ["ai.volumes"]="Read current skeleton-driven Bullet hit-volume centres.",
            ["ai.route"]="Find a supported, capsule-clear route to {target={x,y,z},id=enemy_1..enemy_6}; id defaults to enemy_1.",
            ["ai.patrol"]="Set 1-8 {points={{x,y,z},...},id=enemy_1..enemy_6} for repeatable navigation scenarios; clear actor alert and claims.",
            ["gameplay.restart"]="Restart the encounter, restoring player, weapons and both squads.",
        }) do
            automation_bridge.describe("command",name,{description=description,input_schema={type="object"},output_schema={type="object"}})
        end
        automation_bridge.command("combat_fx.snapshot",function() return combat_fx.snapshot(self.combat_visuals) end)
        automation_bridge.command("grenades.snapshot",function() return grenades.snapshot(self.ctx) end)
        automation_bridge.command("physics.snapshot",function() return dynamics.snapshot(self.ctx.services.dynamics) end)
        automation_bridge.command("weapons.snapshot", function() return weapon_system.snapshot(self.ctx) end)
        automation_bridge.command("weapons.drive", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            local drive = weapon_driver.new(data.segments)
            select_view(self, nil)
            self.weapon_drive = drive
            return { accepted = true }
        end)
        automation_bridge.command("weapons.result", function()
            return { complete = self.weapon_drive and self.weapon_drive.complete or false,
                result = self.weapon_drive and self.weapon_drive.result }
        end)
        automation_bridge.command("weapons.range", function()
            create_range(self)
            return firing_range.snapshot(self.ctx, self.range)
        end)
        for name, description in pairs({
            ["weapons.snapshot"] = "Read weapon, mode, magazine/chamber/reserve, clip, ADS, recoil and projectile counts.",
            ["weapons.drive"] = "Replay 1-64 {ticks, fire, aim, reload, inspect, fire_mode, next_weapon, weapon_rifle, weapon_smg, weapon_pistol, sprint, forward, crouch} input segments, at most 2400 ticks.",
            ["weapons.result"] = "Read completion and the frozen final weapon snapshot of the latest drive.",
            ["weapons.range"] = "Create optional Bullet firing fixtures at z=23..47 and read target health. Lanes x=-5/0/5 are bare/wood/concrete.",
        }) do
            automation_bridge.describe("command", name, { description=description,
                input_schema={type="object"}, output_schema={type="object"} })
        end
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
        automation_bridge.describe("state", "world", {
            description = "Generation phase and counts. ready becomes true after meshes and collision objects are installed.",
            schema = { type = "object", properties = { ready = { type = "boolean" }, phase = { type = "string" } } },
        })
        automation_bridge.command("world.snapshot", function() return world_snapshot(self.ctx.world) end)
        automation_bridge.command("world.mesh_fingerprints",function(data)
            assert(self.ctx.world.ready,"World is still loading")
            local offset,limit=data.offset or 0,data.limit or 16
            assert(offset>=0 and offset==math.floor(offset),"Invalid mesh offset")
            assert(limit>=1 and limit<=16 and limit==math.floor(limit),"Mesh page limit must be 1-16")
            local batches=self.ctx.world.batches
            local result={total=#batches,batches={}}
            for i=offset+1,math.min(#batches,offset+limit) do
                local batch=batches[i]
                local data=resource.get_buffer(batch.resource)
                local entry={key=batch.key,vertices=batch.vertex_count,bounds=batch.bounds,streams={}}
                for _,name in ipairs({"position","normal","color","surface_edges","surface_masks","surface_data"}) do
                    if name~="surface_data" or not batch.glass then
                        local bytes=buffer.get_bytes(data,hash(name))
                        entry.streams[name]={bytes=#bytes,hash=hash_to_hex(hash(bytes))}
                    end
                end
                result.batches[#result.batches+1]=entry
            end
            return result
        end)
        automation_bridge.command("world.navigation", function(data)
            -- A full-map graph exceeds the bridge's 32 KiB JSON limit. Return
            -- explicit pages with totals so inspection never silently truncates.
            local offset,limit=data.offset or 0,data.limit or 32
            assert(offset>=0 and offset==math.floor(offset),"Invalid navigation offset")
            assert(limit>=1 and limit<=32 and limit==math.floor(limit),"Navigation page limit must be 1-32")
            local result={offset=offset,limit=limit,counts={}}
            for _,key in ipairs({"nodes","edges","surfaces","flanks","stairs"}) do
                local items=self.ctx.world.navigation[key] or {}
                local page={}
                result.counts[key]=#items
                for i=offset+1,math.min(#items,offset+limit) do page[#page+1]=items[i] end
                result[key]=page
            end
            return result
        end)
        automation_bridge.command("world.validate", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            local query
            if data.capsules then
                local e=assert(self.ctx.ai.actors["enemy_1"],"No soldier for capsule validation")
                query=assert(soldier_adapter.query(self.ctx.services.soldiers,e),"Soldier physics is settling")
            end
            return world_adapter.validate(self.ctx.world.adapter, self.ctx.world, query)
        end)
        automation_bridge.command("world.raycast", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            return world_adapter.raycast(self.ctx.world.adapter, data.from, data.to)
        end)
        automation_bridge.command("world.view", function(data)
            assert(self.ctx.world.views[data.name], "Unknown inspection view")
            select_view(self, data.name)
            return { name = self.view }
        end)
        automation_bridge.command("movement.course", function()
            create_course(self)
            return { ready = true }
        end)
        automation_bridge.command("movement.reset", function(data)
            msg.post("@render:","renderer_reset_history",{reason="teleport"})
            assert(self.ctx.world.ready, "World is still loading")
            for _, key in ipairs({ "x", "y", "z" }) do
                assert(type(data[key]) == "number" and data[key] == data[key] and math.abs(data[key]) < 10000, "Invalid "..key)
            end
            local yaw = data.yaw or 0
            assert(type(yaw) == "number" and yaw == yaw and math.abs(yaw) < 10000, "Invalid yaw")
            if data.velocity then
                for _, key in ipairs({ "x", "y", "z" }) do
                    local value = data.velocity[key] or 0
                    assert(type(value) == "number" and value == value and math.abs(value) <= 200, "Invalid velocity")
                end
            end
            select_view(self, nil)
            player_system.reset(self.ctx, data, yaw)
            if data.velocity then
                for _, key in ipairs({ "x", "y", "z" }) do
                    local value = data.velocity[key] or 0
                    self.ctx.player.motion.velocity[key] = value
                end
            end
            return snapshot(self.ctx)
        end)
        automation_bridge.command("movement.drive", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            select_view(self, nil)
            self.ctx.player.drive = driver.new(data.segments)
            return { accepted = true }
        end)
        automation_bridge.command("movement.result", function()
            local drive = self.ctx.player.drive
            return { complete = drive and drive.complete or false, result = drive and drive.result }
        end)
        for name, description in pairs({
            ["movement.course"] = "Create the optional traversal course at x=44..112; does not move the player.",
            ["movement.reset"] = "Reset feet to x/y/z and optional yaw/velocity for a repeatable traversal fixture.",
            ["movement.drive"] = "Drive input segments {ticks, move_x, move_z, sprint, crouch, prone, jump, jump_held, lean, look_x, look_y}. Jump is an edge on the first tick; sprint/crouch edges follow hold transitions or explicit sprint_pressed/crouch_pressed.",
            ["movement.result"] = "Read completion and immutable final metrics for the latest movement drive.",
        }) do
            automation_bridge.describe("command", name, { description = description,
                input_schema = { type = "object" }, output_schema = { type = "object" } })
        end
        for name, description in pairs({
            ["world.snapshot"] = "Read generated world counts, loading phase and CPU loading time.",
            ["world.mesh_fingerprints"] = "Read native mesh stream byte counts/hashes and bounds; paged with {offset=0,limit=16}. Debug verification after loading, not a frame-time measurement.",
            ["world.navigation"] = "Read graph pages with totals: {offset=0,limit=32}; increment offset until every counts entry is reached.",
            ["world.validate"] = "Compare installed collision and navigation support. Set {capsules=true} to sweep every edge in both directions using AI physics.",
            ["world.raycast"] = "Cast from/to {x,y,z} through generated collision; returns the hit surface identifier and position.",
            ["world.view"] = "Select street, courtyard, rear, alley, shop, room, stairs, upstairs, e2_shop, e2_stairs, e2_upstairs or e2_top inspection camera.",
        }) do
            automation_bridge.describe("command", name, { description = description,
                input_schema = { type = "object" }, output_schema = { type = "object" } })
        end
        automation_bridge.command("gameplay.snapshot", function()
            return snapshot(self.ctx)
        end)
        automation_bridge.describe("command", "gameplay.snapshot", {
            description = "Read simulation timing, input intent, health and physics configuration.",
            output_schema = { type = "object" },
        })
        automation_bridge.command("gameplay.damage", function(hit)
            return { accepted = combat.request(self.ctx.combat, hit) }
        end)
        automation_bridge.describe("command", "gameplay.damage", {
            description = "Queue a debug hit. Health changes at the next fixed tick through the combat owner.",
            input_schema = { type = "object", required = { "target", "amount" },
                properties = { target = { type = "string" }, amount = { type = "number", exclusiveMinimum = 0 } } },
            output_schema = { type = "object", properties = { accepted = { type = "boolean" } } },
        })
    end
    print("Gameplay framework ready: 120 Hz, 3D physics, metres, gravity -20.6 m/s^2")
end

function fixed_update(self, dt)
    if self.ctx.paused or self.capture then return end
    -- Collision objects acquire their Bullet broadphase handles after init.
    if self.ctx.world.ready and not self.ctx.services.capsule then
        self.ctx.services.capsule = capsule_queries.new("/player#collision", self.ctx.world.adapter.by_id)
        self.ctx.services.capsule:sync(self.ctx.player.position, self.ctx.player.motion.height)
    end
    if self.weapon_drive then weapon_driver.before(self.ctx, self.weapon_drive) end
    runtime.fixed_update(self.ctx, dt)
    if self.ctx.world.ready then require("game.world.generator").mark(self.ctx.world,"gameplay") end
    if self.weapon_drive then weapon_driver.after(self.ctx, self.weapon_drive) end
    -- Keep the GO and kinematic Bullet transform at the authoritative feet.
    local p = self.ctx.player.position
    self.position.x, self.position.y, self.position.z = p.x, p.y, p.z
    go.set_position(self.position, "/player")
end

function update(self, dt)
    if self.animated_atmosphere_validation then require("tests.animated_atmosphere_scenario").update(self.animated_atmosphere_validation,self,dt,restart_encounter) end
    if self.rendering_validation then require("tests.rendering_browser").update(self.rendering_validation,self,dt) end
    if self.capture then ui.sync_touch(self);return end
    runtime.update(self.ctx, dt)
    ui.sync_touch(self)
    if self.renderer_stats.ready then require("game.world.generator").mark(self.ctx.world,"renderer_ready") end
    if self.ctx.world.ready and self.renderer_stats.ready then
        require("game.world.generator").mark(self.ctx.world,"playable")
    end
    if self.mesh_validation then require("tests.mesh_browser").update(self.mesh_validation,self) end
    if self.audio_content_validation then require("tests.audio_content_scenario").update(self.audio_content_validation,self,dt,restart_encounter) end
    if self.audio_validation then require("tests.audio_browser").update(self.audio_validation,self) end
    if self.ctx.world.ready and self.shadow_world~=self.ctx.world then
        self.shadow_world=self.ctx.world
        msg.post("@render:","renderer_world_ready",{})
    end
    if self.market_validation then require("tests.market_browser").update(self.market_validation,self,dt) end
    if self.traversal_validation then require("tests.traversal_scenario").update(self.traversal_validation,self,dt) end
    if self.viewmodel_validation then require("tests.viewmodel_scenario").update(self.viewmodel_validation,self,dt,restart_encounter) end
    if self.health_validation then require("tests.health_scenario").update(self.health_validation,self,dt,restart_encounter) end
    if self.hud_validation then require("tests.hud_scenario").update(self.hud_validation,self,dt,restart_encounter) end
    if self.soldier_validation then require("tests.soldier_scenario").update(self.soldier_validation,self,dt,restart_encounter) end
    if self.effects_validation then require("tests.effects_scenario").update(self.effects_validation,self,dt,restart_encounter) end
    if self.grenades_validation then require("tests.grenades_scenario").update(self.grenades_validation,self,dt,restart_encounter) end
    if self.ai_tactics_validation then require("tests.ai_tactics_scenario").update(self.ai_tactics_validation,self,dt,restart_encounter) end
    if self.physics_validation then require("tests.physics_scenario").update(self.physics_validation,self,dt,restart_encounter) end
    if self.ballistics_validation then require("tests.ballistics_scenario").update(self.ballistics_validation,self,dt,restart_encounter) end
    if self.squad_validation then
        require("tests.squads_browser").update(self.squad_validation,self,dt,restart_encounter)
    end
    if self.suppression_validation then
        require("tests.suppression_scenario").update(self.suppression_validation,self.ctx)
    end
    if automation_bridge and self.world_phase ~= self.ctx.world.phase then
        self.world_phase = self.ctx.world.phase
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
    end
end

local function update_lights(self,camera,dt)
    local previous=self.light_camera
    if previous and (camera.x-previous.x)^2+(camera.y-previous.y)^2+(camera.z-previous.z)^2>4 then self.active_lights=nil end
    self.light_camera={x=camera.x,y=camera.y,z=camera.z}
    if self.active_volumes~=self.ctx.world.lighting_volumes then
        self.active_volumes=self.ctx.world.lighting_volumes
        -- Eight nested volume tables exceed HTML5's message payload budget.
        -- Ordered messages install one complete volume at a time before draw.
        msg.post("@render:","renderer_volumes",{count=#self.active_volumes})
        for i,volume in ipairs(self.active_volumes) do
            msg.post("@render:","renderer_volumes",{index=i,volume=volume})
        end
    end
    local lights_source=self.capture and self.capture.shot.laboratory and require("game.render.laboratory").lights or self.ctx.world.lights
    self.light_selection=require("game.render.local_lights").update(self.light_selection,lights_source,camera,dt,not self.active_lights)
    local reset=not self.active_lights
    self.active_lights=true
    local lights,shadow_candidates={},{}
    for _,slot in ipairs(self.light_selection.slots) do
        local light=slot.light
        if light then
            shadow_candidates[#shadow_candidates+1]=light
            local lo,hi=light.minimum,light.maximum
            local colour,power=light.colour or {1,.76,.48},(light.intensity or 16)*slot.gain
            lights[#lights+1]={position=vmath.vector4(light.x,light.y,light.z,light.radius),
                colour=vmath.vector4(colour[1]*power,colour[2]*power,colour[3]*power,0),
                minimum=vmath.vector4(lo.x,lo.y,lo.z,0),maximum=vmath.vector4(hi.x,hi.y,hi.z,0)}
        else
            lights[#lights+1]={position=vmath.vector4(),colour=vmath.vector4(),minimum=vmath.vector4(),maximum=vmath.vector4()}
        end
    end
    self.shadow_selection=require("game.render.local_lights").update(self.shadow_selection,shadow_candidates,camera,dt,reset,2)
    local shadow_positions,shadow_slots={},vmath.vector4(-1,0,-1,0)
    for i=1,2 do
        local shadow=self.shadow_selection.slots[i]
        shadow_positions[i]=vmath.vector4()
        if shadow and shadow.light then
            for slot,active in ipairs(self.light_selection.slots) do
                if active.light==shadow.light then
                    shadow_positions[i]=lights[slot].position
                    if i==1 then shadow_slots.x=slot-1;shadow_slots.y=shadow.gain
                    else shadow_slots.z=slot-1;shadow_slots.w=shadow.gain end
                end
            end
        end
    end
    msg.post("@render:","renderer_lights",{lights=lights,shadow_positions=shadow_positions,shadow_slots=shadow_slots})
    local positions,colours={},{}
    for i=1,2 do
        local flash=not self.capture and self.ctx.fx.flashes[i]
        local position=flash and (flash.source=="player" and self.player_muzzle or flash.position)
        positions[i]=position and vmath.vector4(position.x,position.y,position.z,flash.radius or 4) or vmath.vector4()
        local power=flash and (flash.power or 28)*math.min(1,flash.life/.025) or 0
        colours[i]=vmath.vector4(power,power*.58,power*.22,0)
    end
    msg.post("@render:","renderer_flashes",{positions=positions,colours=colours})
end

function late_update(self, dt)
    -- Camera and GUI see interpolated presentation, never drive simulation.
    local out = self.ctx.presentation
    if profiler then profiler.scope_begin("late.soldiers") end
    ai_system.present(self.ctx)
    dynamics.present(self.ctx.services.dynamics,self.ctx.time.alpha,self.capture~=nil)
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.view") end
    if self.capture and self.capture.playing then
        local c=self.capture
        c.frame=c.frame+c.direction
        if c.frame>=120 then c.frame=120;c.direction=-1 elseif c.frame<=0 then c.frame=0;c.direction=1 end
    end
    local view = self.capture and capture_shots.camera(self.capture.shot,self.capture.frame)
        or self.view and self.ctx.world.views[self.view]
    local camera = view and view.position or out.camera
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.audio") end
    if not self.capture then audio_system.present(self.ctx,dt,camera,view and view.yaw or out.yaw) end
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.camera") end
    self.camera_position.x, self.camera_position.y, self.camera_position.z = camera.x, camera.y, camera.z
    go.set_position(self.camera_position, "/camera")
    go.set_rotation(vmath.quat_rotation_y(view and view.yaw or out.yaw) * vmath.quat_rotation_x(view and view.pitch or out.pitch)
        * vmath.quat_rotation_z(view and 0 or out.roll), "/camera")
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.weapon") end
    local visible = self.capture and self.capture.shot.weapon~=nil
        or not view and self.ctx.world.ready and self.ctx.player.actor.alive
    local weapon_pose = weapon_adapter.update(self.weapon_visuals, self.ctx, (self.ctx.paused or self.capture) and 0 or dt,
        visible,self.capture and (self.capture.shot.weapon or "hidden"),
        self.capture and self.capture.shot.weapon_id,self.capture and self.capture.shot.firing)
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.render_state") end
    msg.post("@render:","renderer_photographic_state",{
        ads=self.capture and (self.capture.shot.weapon=="ads" and 1 or 0) or (visible and self.ctx.weapons.ads or 0),
        paused=not self.capture and self.ctx.paused or false,
        health=not view and vmath.vector4(self.ctx.player.health_state.effect,
            self.ctx.player.health_state.pulse,self.ctx.player.health_state.hit_flash,0) or vmath.vector4()})
    local active_flash=visible and weapon_pose.parts.flash.visible or false
    if self.weapon_flash_active~=active_flash then
        self.weapon_flash_active=active_flash
        msg.post("@render:","renderer_weapon_flash",{active=active_flash})
    end
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.muzzle") end
    local part=weapon_pose.parts.flash.position
    local r=weapon_pose.rotation
    local q=vmath.quat_rotation_y(r[2])*vmath.quat_rotation_x(r[1])*vmath.quat_rotation_z(r[3])
    local origin=weapon_pose.position
    local local_muzzle=vmath.vector3(origin[1],origin[2],origin[3])+vmath.rotate(q,vmath.vector3(part[1],part[2],part[3]))
    self.player_muzzle=self.camera_position+vmath.rotate(go.get_rotation("/camera"),local_muzzle)
    if self.ctx.weapons.flash>0 and not self.capture then
        local hit=physics.raycast(self.camera_position,self.player_muzzle,{hash("world")})
        if hit then self.player_muzzle=hit.position+hit.normal*.03 end
    end
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.combat_fx") end
    combat_fx.update(self.combat_visuals,(self.ctx.paused or self.capture) and 0 or dt,go.get_rotation("/camera"),self.player_muzzle,
        self.capture~=nil,self.renderer_settings.combat_effects,self.camera_position,1-(self.renderer_stats.night_amount or 0))
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.lights") end
    update_lights(self,camera,dt)
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.fov") end
    go.set("/camera#camera", "fov", view and (view.fov or math.rad(70)) or out.fov)
    go.set("/viewmodel#camera", "fov", weapon_pose.view_fov)
    if profiler then profiler.scope_end() end

    if profiler then profiler.scope_begin("late.hud") end
    local weapon = weapon_system.snapshot(self.ctx)
    local ammo = string.format("%s  %s  %d / %d", weapon.label, string.upper(weapon.mode), weapon.ammo, weapon.reserve)
    local clip_labels = { reloadTac="RELOADING", reloadEmpty="RELOADING", inspect="INSPECTING",
        draw="EQUIPPING", holster="SWITCHING" }
    local weapon_status = clip_labels[weapon.clip] or ""
    local aiming = weapon.ads > 0.8
    local hit = self.ctx.fx.hitmarker > 0
    local hurt = self.ctx.fx.damage_flash > 0
    local loading = not self.ctx.world.ready
    local motion = self.ctx.player.motion
    local title = view and view.title or (motion.mantle and (motion.mantle.kind == "vault" and "VAULT" or "MANTLE") or motion.sliding and "SLIDE"
        or motion.tactical and "TACTICAL SPRINT" or string.upper(motion.stance))
    local state = hud_model.snapshot(self.ctx)
    state.health, state.hit, state.hurt = out.health, hit, hurt
    state.loading, state.title = loading, title
    state.ammo, state.weapon_status, state.aiming = ammo, weapon_status, aiming
    state.paused, state.mouse_locked, state.inspecting = self.ctx.paused, window.get_mouse_lock(), view ~= nil
    state.diagnostic = self.renderer_settings.view ~= "scene"
    state.spread = weapon.spread or 0
    state.touch_controls=self.touch.enabled
    msg.post("/hud#gui", HUD_STATE, state)
    local feedback=hud_feedback.snapshot(self.ctx)
    feedback.visible=state.alive and not state.loading and not state.inspecting and not state.diagnostic
    local width,height=window.get_size()
    width,height=math.max(1,width),math.max(1,height)
    local scale=math.min(width/960,height/640)
    local items=hud_feedback.items(self.ctx,width/scale,height/scale)
    for kind,list in pairs(items) do feedback[kind]=#list end
    msg.post("/hud#gui","hud_feedback",feedback)
    for kind,list in pairs(items) do
        for i,item in ipairs(list) do
            item.kind_colour=item.kind;item.kind=kind;item.index=i
            msg.post("/hud#gui","hud_feedback_item",item)
        end
    end
    if self.touch.enabled then
        msg.post("/hud#gui","touch_state",{enabled=not self.capture,active=self.touch.active,
            paused=self.ctx.paused,focused=self.focused,move_x=self.touch.move_x,move_z=self.touch.move_z,
            held=self.touch.held})
    end
    if profiler then profiler.scope_end() end
    if self.ctx.world.ready and not self.map_sent then
        if profiler then profiler.scope_begin("late.map_upload") end
        -- Keep each message below Defold's message payload limit.
        for _, shape in ipairs(self.ctx.world.minimap) do
            msg.post("/hud#gui", "map_rect", shape)
        end
        self.map_sent = true
        if profiler then profiler.scope_end() end
    end
end

handle_input = function(self, action_id, action)
    if action_id==TOUCH then
        if self.capture then return true end
        return ui.touch_input(self,action)
    end
    -- Defold also emits mouse-button/pointer events for the first finger.
    -- Ignore their touch source before menus, fire, or pointer lock can see it.
    if action.source==TOUCH_SOURCE then return true end
    if self.capture then
        if action_id==ESCAPE and action.pressed then capture_controller.finish(self) end
        return true
    end
    local name = actions[action_id]
    ui_controls.observe(self.ui, name, action)
    if action_id == ESCAPE and action.pressed then
        ui.pause(self, not self.ctx.paused)
        return true
    end
    if ui.menu_input(self, action_id, action) then return true end
    if name and not ui_controls.allowed(self.ui, name) then return true end
    if action_id==hash("restart_encounter") and action.pressed and self.ctx.world.ready then
        restart_encounter(self)
        return true
    end
    if action.pressed and action_id == PLAY then
        select_view(self, nil)
        return true
    end
    if action_id == hash("firing_range") and action.pressed and self.ctx.world.ready then
        create_range(self)
        select_view(self, nil)
        player_system.reset(self.ctx, { x = -5, y = 0.01, z = 40 }, 0)
        return true
    end
    if action_id == COURSE and action.pressed and self.ctx.world.ready then
        create_course(self)
        select_view(self, nil)
        player_system.reset(self.ctx, { x = 56, y = 0.01, z = 0 }, 0)
        return true
    end
    if VIEW_ACTIONS[action_id] and action.pressed then
        select_view(self, VIEW_ACTIONS[action_id])
        return true
    end
    if not action_id then
        if window.get_mouse_lock() and not self.view then
            local dx, dy = action.dx, action.dy
            if IS_HTML5 then
                -- Locked browser deltas are already relative mouse movement.
                -- dx/dy scale them down with the canvas size (including high DPI).
                dx, dy = action.screen_dx, action.screen_dy
            end
            input.look(self.ctx.input, (dx or 0)*self.ui.sensitivity, (dy or 0)*self.ui.sensitivity)
        end
        return false
    end
    if action_id == hash("fire") and action.pressed and not window.get_mouse_lock() then
        select_view(self, nil)
        ui_controls.quarantine(self.ui)
        window.set_mouse_lock(true)
        return true
    end
    if (name == "fire" or name == "aim") and not window.get_mouse_lock() then return true end
    if name then return input.button(self.ctx.input, name, action) end
    return false
end

function on_input(self, action_id, action)
    return handle_input(self, action_id, action)
end

function on_message(self, message_id, message, sender)
    if message_id==hash("hud_receipt") then self.hud_receipt=message end
    if message_id == hash("ui_action") then ui.action(self, message) end
    if message_id == hash("renderer_stats") or message_id == hash("renderer_atmosphere") or message_id == hash("renderer_details") or message_id == hash("renderer_photographic") or message_id == hash("renderer_configuration") then
        for k,v in pairs(message) do self.renderer_stats[k]=v end
    end
    if message_id == APPLY_DAMAGE then combat.request(self.ctx.combat, message) end
end

function final(self)
    if self.capture_lab then require("game.render.laboratory").final(self.capture_lab) end
    window.set_mouse_lock(false)
    window.set_listener(nil)
    msg.post(".", "release_input_focus")
    -- Automation Bridge clears callbacks with the Lua application lifecycle.
    combat_fx.final(self.combat_visuals,self.ctx)
    grenades.reset(self.ctx)
    dynamics.final(self.ctx.services.dynamics)
    weapon_adapter.final(self.weapon_visuals, self.ctx)
    if self.range then firing_range.final(self.ctx, self.range) end
    runtime.final(self.ctx)
    if self.course then course.final(self.course) end
end
