local runtime = require "game.runtime"
local input = require "game.input"
local combat = require "game.combat"
local config = require "game.config"
local world_adapter = require "game.world.defold"

local actions = {}
for _, name in ipairs(input.actions) do actions[hash(name)] = name end
local APPLY_DAMAGE = hash("apply_damage")
local HUD_STATE = hash("hud_state")
local VIEW_ACTIONS = { [hash("view_street")] = "street", [hash("view_shop")] = "shop", [hash("view_room")] = "room" }

local function world_snapshot(world)
    return { ready = world.ready, phase = world.phase, seed = world.seed,
        boxes = world.stats.boxes, vertices = world.stats.vertices, mesh_bytes = world.stats.mesh_bytes,
        batches = world.stats.batches, colliders = world.stats.colliders,
        navigation_nodes = #world.navigation.nodes, navigation_edges = #world.navigation.edges,
        cover_candidates = #world.cover, spawn_points = #world.spawn_points,
        work_ms = world.work_seconds * 1000, peak_job_ms = world.peak_job_seconds * 1000 }
end

local function snapshot(ctx)
    return {
        tick = ctx.time.tick, elapsed = ctx.time.elapsed,
        frame = ctx.time.frame, frame_elapsed = ctx.time.frame_elapsed,
        fixed_dt = ctx.time.fixed_dt, alpha = ctx.time.alpha,
        health = ctx.player.actor.health, alive = ctx.player.actor.alive,
        move_x = ctx.player.intent.move_x, move_z = ctx.player.intent.move_z,
        physics = sys.get_config_string("physics.type"),
        gravity = sys.get_config_number("physics.gravity_y"),
        physics_scale = sys.get_config_number("physics.scale"),
    }
end

local function window_event(self, event)
    if event == window.WINDOW_EVENT_FOCUS_LOST then input.reset(self.ctx.input) end
end

function init(self)
    assert(sys.get_config_int("engine.fixed_update_frequency") == config.fixed_frequency,
        "game.project and game.config must agree on the fixed update frequency")
    assert(math.abs(sys.get_config_number("physics.gravity_y") - config.gravity) < 0.00001,
        "game.project and game.config must agree on gravity")
    assert(sys.get_config_string("physics.type") == "3D"
        and sys.get_config_number("physics.scale") == 1
        and sys.get_config_boolean("physics.use_fixed_timestep"),
        "Gameplay requires metre-based 3D physics with a fixed timestep")
    self.ctx = runtime.new({ world = world_adapter.new("#world_mesh", "#world_collision") })
    self.view = "street"
    self.position = vmath.vector3()
    self.camera_position = vmath.vector3()
    self.hud = {}
    msg.post(".", "acquire_input_focus")
    window.set_listener(window_event)
    if automation_bridge then
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
        automation_bridge.describe("state", "world", {
            description = "Generation phase and counts. ready becomes true after meshes and collision objects are installed.",
            schema = { type = "object", properties = { ready = { type = "boolean" }, phase = { type = "string" } } },
        })
        automation_bridge.command("world.snapshot", function() return world_snapshot(self.ctx.world) end)
        automation_bridge.command("world.validate", function()
            assert(self.ctx.world.ready, "World is still loading")
            return world_adapter.validate(self.ctx.world.adapter, self.ctx.world)
        end)
        automation_bridge.command("world.raycast", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            return world_adapter.raycast(self.ctx.world.adapter, data.from, data.to)
        end)
        automation_bridge.command("world.view", function(data)
            assert(self.ctx.world.views[data.name], "Unknown inspection view")
            self.view = data.name
            return { name = self.view }
        end)
        for name, description in pairs({
            ["world.snapshot"] = "Read generated world counts, loading phase and CPU loading time.",
            ["world.validate"] = "Compare all installed collision dimensions and positions; ray-check navigation support and connections.",
            ["world.raycast"] = "Cast from/to {x,y,z} through generated collision; returns the hit surface identifier and position.",
            ["world.view"] = "Select the street, shop or room inspection camera without changing player simulation state.",
        }) do
            automation_bridge.describe("command", name, { description = description,
                input_schema = { type = "object" }, output_schema = { type = "object" } })
        end
        automation_bridge.command("gameplay.snapshot", function()
            return snapshot(self.ctx)
        end)
        automation_bridge.describe("command", "gameplay.snapshot", {
            description = "Read simulation timing, input intent, health and physics configuration.",
            output_schema = { type = "object" },
        })
        automation_bridge.command("gameplay.damage", function(hit)
            return { accepted = combat.request(self.ctx.combat, hit) }
        end)
        automation_bridge.describe("command", "gameplay.damage", {
            description = "Queue a debug hit. Health changes at the next fixed tick through the combat owner.",
            input_schema = { type = "object", required = { "target", "amount" },
                properties = { target = { type = "string" }, amount = { type = "number", exclusiveMinimum = 0 } } },
            output_schema = { type = "object", properties = { accepted = { type = "boolean" } } },
        })
    end
    print("Gameplay framework ready: 120 Hz, 3D physics, metres, gravity -20.6 m/s^2")
end

function fixed_update(self, dt)
    runtime.fixed_update(self.ctx, dt)
    -- Authoritative actor transform for future collision components.
    local p = self.ctx.player.position
    self.position.x, self.position.y, self.position.z = p.x, p.y, p.z
    go.set_position(self.position, "/player")
end

function update(self, dt)
    runtime.update(self.ctx, dt)
    if automation_bridge and self.world_phase ~= self.ctx.world.phase then
        self.world_phase = self.ctx.world.phase
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
    end
end

function late_update(self, dt)
    -- Camera and GUI see interpolated presentation, never drive simulation.
    local out = self.ctx.presentation
    local view = self.ctx.world.views[self.view]
    local camera = view and view.position or out.camera
    self.camera_position.x, self.camera_position.y, self.camera_position.z = camera.x, camera.y, camera.z
    go.set_position(self.camera_position, "/camera")
    if self.last_view ~= self.view then
        go.set_rotation(vmath.quat_rotation_y(view.yaw) * vmath.quat_rotation_x(view.pitch), "/camera")
        self.last_view = self.view
    end
    local hit = self.ctx.fx.hitmarker > 0
    local hurt = self.ctx.fx.damage_flash > 0
    local loading = not self.ctx.world.ready
    if self.hud.health ~= out.health or self.hud.hit ~= hit or self.hud.hurt ~= hurt
        or self.hud.loading ~= loading or self.hud.title ~= view.title then
        self.hud.health, self.hud.hit, self.hud.hurt = out.health, hit, hurt
        self.hud.loading, self.hud.title = loading, view.title
        msg.post("/hud#gui", HUD_STATE, self.hud)
    end
end

function on_input(self, action_id, action)
    if VIEW_ACTIONS[action_id] and action.pressed then
        self.view = VIEW_ACTIONS[action_id]
        return true
    end
    if not action_id then
        input.look(self.ctx.input, action.dx or 0, action.dy or 0)
        return false
    end
    local name = actions[action_id]
    if name then return input.button(self.ctx.input, name, action) end
    return false
end

function on_message(self, message_id, message, sender)
    if message_id == APPLY_DAMAGE then combat.request(self.ctx.combat, message) end
end

function final(self)
    window.set_listener(nil)
    msg.post(".", "release_input_focus")
    -- Automation Bridge clears callbacks with the Lua application lifecycle.
    runtime.final(self.ctx)
end
