local runtime = require "game.runtime"
local input = require "game.input"
local combat = require "game.combat"
local config = require "game.config"
local world_adapter = require "game.world.defold"
local capsule_queries = require "game.player.bullet"
local player_system = require "game.systems.player"
local driver = require "game.player.driver"
local course = require "game.player.course"
local weapon_system = require "game.systems.weapons"
local weapon_adapter = require "game.weapons.defold"
local weapon_driver = require "game.weapons.driver"
local firing_range = require "game.weapons.range"
local ai_system = require "game.systems.ai"
local soldier_adapter = require "game.ai.defold"
local renderer_settings = require "game.render.settings"
local audio_system = require "game.systems.audio"
local audio_adapter = require "game.audio.defold"

local actions = {}
for _, name in ipairs(input.actions) do actions[hash(name)] = name end
local APPLY_DAMAGE = hash("apply_damage")
local HUD_STATE = hash("hud_state")
local VIEW_ACTIONS = { [hash("view_street")] = "street", [hash("view_shop")] = "shop", [hash("view_room")] = "room" }
local PLAY, ESCAPE, COURSE = hash("play"), hash("release_mouse"), hash("course")

local function select_view(self, name)
    self.view = name
    self.ctx.player.enabled = not name
    self.ctx.player.drive = nil
    self.weapon_drive = nil
    input.reset(self.ctx.input)
    window.set_mouse_lock(false)
end

local function create_course(self)
    assert(self.ctx.world.ready, "World is still loading")
    if not self.course then self.course = course.create() end
end

local function create_range(self)
    assert(self.ctx.world.ready, "World is still loading")
    if not self.range then
        self.range = firing_range.new(self.ctx)
        self.bullet_registries[#self.bullet_registries+1] = self.range.adapter.by_id
    end
end

local function restart_encounter(self)
    audio_system.reset(self.ctx)
    select_view(self,nil)
    combat.remove(self.ctx.combat,"player")
    self.ctx.player.actor=combat.register(self.ctx.combat,"player",config.player_health)
    player_system.reset(self.ctx,self.ctx.world.spawn,0)
    weapon_system.init(self.ctx)
    self.ctx.ai.enabled=true
    ai_system.reset(self.ctx)
    self.ctx.fx.hitmarker,self.ctx.fx.damage_flash=0,0
end

local function world_snapshot(world)
    return { ready = world.ready, phase = world.phase, seed = world.seed,
        boxes = world.stats.boxes, vertices = world.stats.vertices, mesh_bytes = world.stats.mesh_bytes,
        batches = world.stats.batches, colliders = world.stats.colliders,
        navigation_nodes = #world.navigation.nodes, navigation_edges = #world.navigation.edges,
        cover_candidates = #world.cover, spawn_points = #world.spawn_points,
        work_ms = world.work_seconds * 1000, peak_job_ms = world.peak_job_seconds * 1000 }
end

local function snapshot(ctx)
    local motion = ctx.player.motion
    return {
        tick = ctx.time.tick, elapsed = ctx.time.elapsed,
        frame = ctx.time.frame, frame_elapsed = ctx.time.frame_elapsed,
        fixed_dt = ctx.time.fixed_dt, alpha = ctx.time.alpha,
        health = ctx.player.actor.health, alive = ctx.player.actor.alive,
        move_x = ctx.player.intent.move_x, move_z = ctx.player.intent.move_z,
        physics = sys.get_config_string("physics.type"),
        gravity = sys.get_config_number("physics.gravity_y"),
        physics_scale = sys.get_config_number("physics.scale"),
        x = ctx.player.position.x, y = ctx.player.position.y, z = ctx.player.position.z,
        vx = motion.velocity.x, vy = motion.velocity.y, vz = motion.velocity.z,
        grounded = motion.grounded, stance = motion.stance, height = motion.height,
        yaw = motion.yaw, pitch = motion.pitch, recovery_failed = motion.recovery_failed,
        mouse_locked = window.get_mouse_lock(),
        sliding = motion.sliding, tactical = motion.tactical, mantling = motion.mantle ~= false,
        lean = motion.lean, slide_cooldown = motion.slide_cooldown, tactical_cooldown = motion.tactical_cooldown,
        camera_x = ctx.presentation.camera.x, camera_y = ctx.presentation.camera.y, camera_z = ctx.presentation.camera.z,
        camera_roll = ctx.presentation.roll or 0,
    }
end

local function window_event(self, event)
    if event == window.WINDOW_EVENT_FOCUS_LOST then
        input.reset(self.ctx.input)
        window.set_mouse_lock(false)
        audio_system.suspend(self.ctx,true)
    elseif event == window.WINDOW_EVENT_FOCUS_GAINED then
        audio_system.suspend(self.ctx,false)
    end
end

function init(self)
    assert(sys.get_config_int("engine.fixed_update_frequency") == config.fixed_frequency,
        "game.project and game.config must agree on the fixed update frequency")
    assert(math.abs(sys.get_config_number("physics.gravity_y") - config.gravity) < 0.00001,
        "game.project and game.config must agree on gravity")
    assert(sys.get_config_string("physics.type") == "3D"
        and sys.get_config_number("physics.scale") == 1
        and sys.get_config_boolean("physics.use_fixed_timestep"),
        "Gameplay requires metre-based 3D physics with a fixed timestep")
    self.ctx = runtime.new({ world = world_adapter.new("#world_mesh", "#world_collision"),
        audio = audio_adapter.new("#audio_voice","#audio_loop") })
    self.renderer_settings = renderer_settings.defaults()
    self.renderer_stats = { ready = false }
    local lights = {}
    for _,light in ipairs(self.ctx.world.lights) do
        if light.kind ~= "sun" and #lights < renderer_settings.max_lights then
            local lo,hi=light.minimum,light.maximum
            local colour=light.colour or {1,.76,.48}
            local power=light.intensity or 16
            lights[#lights+1]={position=vmath.vector4(light.x,light.y,light.z,light.radius),
                colour=vmath.vector4(colour[1]*power,colour[2]*power,colour[3]*power,0),
                minimum=vmath.vector4(lo.x,lo.y,lo.z,0),maximum=vmath.vector4(hi.x,hi.y,hi.z,0)}
        end
    end
    msg.post("@render:","renderer_lights",{lights=lights})
    self.weapon_visuals = weapon_adapter.new(self.ctx, "#weapon_mesh", "#weapon_effect")
    self.ctx.services.soldiers=soldier_adapter.new(self.ctx,self.ctx.world.adapter,"#soldier_mesh","#soldier_mover","#soldier_hit")
    self.bullet_registries = { self.ctx.world.adapter.by_id, self.ctx.services.soldiers.by_id }
    self.ctx.services.bullets = weapon_adapter.query(self.bullet_registries)
    self.ctx.services.enemy_bullets=weapon_adapter.query({self.ctx.world.adapter.by_id},
        {groups={hash("world"),hash("player")},actors={[hash("/player")]="player"}})
    self.view = nil
    self.position = vmath.vector3()
    self.camera_position = vmath.vector3()
    self.hud = {}
    msg.post(".", "acquire_input_focus")
    window.set_listener(window_event)
    if automation_bridge then
        automation_bridge.command("audio.snapshot",function() return audio_system.snapshot(self.ctx) end)
        automation_bridge.command("audio.configure",function(data) return audio_system.configure(self.ctx,data) end)
        automation_bridge.command("audio.preview",function(data) return audio_system.preview(self.ctx,data) end)
        automation_bridge.describe("command","audio.snapshot",{description="Read generated sound bank, bounded voices, event counts, listener room and actual mixer peaks.",output_schema={type="object"}})
        automation_bridge.describe("command","audio.configure",{description="Set master/weapons/foley/ambience gains 0..1 or muted boolean.",input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.describe("command","audio.preview",{description="Audition kind shot with weapon rifle/smg/pistol, or kind impact/step with surface; optional world position {x,y,z}. Uses the normal bounded playback path.",input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.command("renderer.snapshot",function() return self.renderer_stats end)
        automation_bridge.command("renderer.configure",function(data)
            self.renderer_settings=renderer_settings.configure(self.renderer_settings,data)
            msg.post("@render:","renderer_configure",self.renderer_settings)
            return self.renderer_settings
        end)
        automation_bridge.describe("command","renderer.snapshot",{
            description="Read GPU bake progress, target sizes/budget, shadow frames and active renderer settings.",
            output_schema={type="object"}})
        automation_bridge.describe("command","renderer.configure",{
            description="Set shadows/normal_maps/local_lights/fog/bloom booleans, exposure 0.25..4, or view scene/albedo/normals/material/shadow/environment. Presentation only.",
            input_schema={type="object"},output_schema={type="object"}})
        automation_bridge.command("ai.snapshot",function() return ai_system.snapshot(self.ctx) end)
        automation_bridge.command("ai.configure",function(data)
            assert(type(data.enabled)=="boolean","enabled must be a boolean")
            self.ctx.ai.enabled=data.enabled
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("ai.reset",function(data)
            assert(self.ctx.world.ready,"World is still loading")
            if data.position then
                for _,key in ipairs({"x","y","z"}) do
                    local v=data.position[key]
                    assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid position")
                end
            end
            local yaw=data.yaw or math.pi
            assert(type(yaw)=="number" and yaw==yaw and math.abs(yaw)<10000,"Invalid yaw")
            ai_system.reset(self.ctx,data.position,yaw)
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("ai.volumes",function()
            local result={}
            for _,shape in pairs(self.ctx.services.soldiers.by_id) do
                if not shape.disabled then result[#result+1]={id=shape.id,x=shape.x,y=shape.y,z=shape.z,headshot=shape.headshot or false} end
            end
            return result
        end)
        automation_bridge.command("ai.route",function(data)
            local e=self.ctx.ai.actors.enemy_1
            assert(e and e.actor.alive,"No living soldier")
            local q=soldier_adapter.query(self.ctx.services.soldiers,e)
            assert(q,"Soldier physics is settling")
            local target=data.target
            assert(type(target)=="table","Missing target")
            for _,key in ipairs({"x","y","z"}) do
                local v=target[key]
                assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid target")
            end
            return {points=require("game.ai.navigation").route(self.ctx.world.navigation,e.position,target,q) or {}}
        end)
        automation_bridge.command("ai.patrol",function(data)
            local e=self.ctx.ai.actors.enemy_1
            assert(e and e.actor.alive,"No living soldier")
            assert(type(data.points)=="table" and #data.points>0 and #data.points<=8,"Expected 1-8 patrol points")
            local points={}
            for i,p in ipairs(data.points) do
                for _,key in ipairs({"x","y","z"}) do
                    local v=p[key]
                    assert(type(v)=="number" and v==v and math.abs(v)<10000,"Invalid patrol point")
                end
                points[i]={x=p.x,y=p.y,z=p.z}
            end
            e.patrol_points=points;e.patrol=1;e.route=nil;e.route_goal=nil;e.memory=0;e.notice=0;e.think=0
            return ai_system.snapshot(self.ctx)
        end)
        automation_bridge.command("gameplay.restart",function()
            assert(self.ctx.world.ready,"World is still loading")
            restart_encounter(self)
            return snapshot(self.ctx)
        end)
        for name,description in pairs({
            ["ai.snapshot"]="Read the soldier state, health, navigation, shots, mesh and palette costs.",
            ["ai.configure"]="Pause/resume AI with {enabled}; frozen soldiers remain shootable.",
            ["ai.reset"]="Replace the soldier, optionally at {position={x,y,z},yaw}; preserve AI pause state.",
            ["ai.volumes"]="Read current skeleton-driven Bullet hit-volume centres.",
            ["ai.route"]="Find a supported, capsule-clear route from the soldier to {target={x,y,z}}.",
            ["ai.patrol"]="Set 1-8 {points={{x,y,z},...}} for repeatable navigation scenarios; clear current alert.",
            ["gameplay.restart"]="Restart the encounter, restoring player, weapons and the soldier.",
        }) do
            automation_bridge.describe("command",name,{description=description,input_schema={type="object"},output_schema={type="object"}})
        end
        automation_bridge.command("weapons.snapshot", function() return weapon_system.snapshot(self.ctx) end)
        automation_bridge.command("weapons.drive", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            local drive = weapon_driver.new(data.segments)
            select_view(self, nil)
            self.weapon_drive = drive
            return { accepted = true }
        end)
        automation_bridge.command("weapons.result", function()
            return { complete = self.weapon_drive and self.weapon_drive.complete or false,
                result = self.weapon_drive and self.weapon_drive.result }
        end)
        automation_bridge.command("weapons.range", function()
            create_range(self)
            return firing_range.snapshot(self.ctx, self.range)
        end)
        for name, description in pairs({
            ["weapons.snapshot"] = "Read weapon, mode, magazine/chamber/reserve, clip, ADS, recoil and projectile counts.",
            ["weapons.drive"] = "Replay 1-64 {ticks, fire, aim, reload, inspect, fire_mode, next_weapon, weapon_rifle, weapon_smg, weapon_pistol, sprint, forward, crouch} input segments, at most 2400 ticks.",
            ["weapons.result"] = "Read completion and the frozen final weapon snapshot of the latest drive.",
            ["weapons.range"] = "Create optional Bullet firing fixtures at z=23..47 and read target health. Lanes x=-5/0/5 are bare/wood/concrete.",
        }) do
            automation_bridge.describe("command", name, { description=description,
                input_schema={type="object"}, output_schema={type="object"} })
        end
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
        automation_bridge.describe("state", "world", {
            description = "Generation phase and counts. ready becomes true after meshes and collision objects are installed.",
            schema = { type = "object", properties = { ready = { type = "boolean" }, phase = { type = "string" } } },
        })
        automation_bridge.command("world.snapshot", function() return world_snapshot(self.ctx.world) end)
        automation_bridge.command("world.validate", function()
            assert(self.ctx.world.ready, "World is still loading")
            return world_adapter.validate(self.ctx.world.adapter, self.ctx.world)
        end)
        automation_bridge.command("world.raycast", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            return world_adapter.raycast(self.ctx.world.adapter, data.from, data.to)
        end)
        automation_bridge.command("world.view", function(data)
            assert(self.ctx.world.views[data.name], "Unknown inspection view")
            select_view(self, data.name)
            return { name = self.view }
        end)
        automation_bridge.command("movement.course", function()
            create_course(self)
            return { ready = true }
        end)
        automation_bridge.command("movement.reset", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            for _, key in ipairs({ "x", "y", "z" }) do
                assert(type(data[key]) == "number" and data[key] == data[key] and math.abs(data[key]) < 10000, "Invalid "..key)
            end
            local yaw = data.yaw or 0
            assert(type(yaw) == "number" and yaw == yaw and math.abs(yaw) < 10000, "Invalid yaw")
            if data.velocity then
                for _, key in ipairs({ "x", "y", "z" }) do
                    local value = data.velocity[key] or 0
                    assert(type(value) == "number" and value == value and math.abs(value) <= 200, "Invalid velocity")
                end
            end
            select_view(self, nil)
            player_system.reset(self.ctx, data, yaw)
            if data.velocity then
                for _, key in ipairs({ "x", "y", "z" }) do
                    local value = data.velocity[key] or 0
                    self.ctx.player.motion.velocity[key] = value
                end
            end
            return snapshot(self.ctx)
        end)
        automation_bridge.command("movement.drive", function(data)
            assert(self.ctx.world.ready, "World is still loading")
            select_view(self, nil)
            self.ctx.player.drive = driver.new(data.segments)
            return { accepted = true }
        end)
        automation_bridge.command("movement.result", function()
            local drive = self.ctx.player.drive
            return { complete = drive and drive.complete or false, result = drive and drive.result }
        end)
        for name, description in pairs({
            ["movement.course"] = "Create the optional native traversal course at x=50..102; does not move the player.",
            ["movement.reset"] = "Reset feet to x/y/z and optional yaw/velocity for a repeatable traversal fixture.",
            ["movement.drive"] = "Drive input segments {ticks, move_x, move_z, sprint, crouch, prone, jump, jump_held, lean, look_x, look_y}. Jump is an edge on the first tick; sprint/crouch edges follow hold transitions or explicit sprint_pressed/crouch_pressed.",
            ["movement.result"] = "Read completion and immutable final metrics for the latest movement drive.",
        }) do
            automation_bridge.describe("command", name, { description = description,
                input_schema = { type = "object" }, output_schema = { type = "object" } })
        end
        for name, description in pairs({
            ["world.snapshot"] = "Read generated world counts, loading phase and CPU loading time.",
            ["world.validate"] = "Compare all installed collision dimensions and positions; ray-check navigation support and connections.",
            ["world.raycast"] = "Cast from/to {x,y,z} through generated collision; returns the hit surface identifier and position.",
            ["world.view"] = "Select the street, shop or room inspection camera and disable player input.",
        }) do
            automation_bridge.describe("command", name, { description = description,
                input_schema = { type = "object" }, output_schema = { type = "object" } })
        end
        automation_bridge.command("gameplay.snapshot", function()
            return snapshot(self.ctx)
        end)
        automation_bridge.describe("command", "gameplay.snapshot", {
            description = "Read simulation timing, input intent, health and physics configuration.",
            output_schema = { type = "object" },
        })
        automation_bridge.command("gameplay.damage", function(hit)
            return { accepted = combat.request(self.ctx.combat, hit) }
        end)
        automation_bridge.describe("command", "gameplay.damage", {
            description = "Queue a debug hit. Health changes at the next fixed tick through the combat owner.",
            input_schema = { type = "object", required = { "target", "amount" },
                properties = { target = { type = "string" }, amount = { type = "number", exclusiveMinimum = 0 } } },
            output_schema = { type = "object", properties = { accepted = { type = "boolean" } } },
        })
    end
    print("Gameplay framework ready: 120 Hz, 3D physics, metres, gravity -20.6 m/s^2")
end

function fixed_update(self, dt)
    -- Collision objects acquire their Bullet broadphase handles after init.
    if self.ctx.world.ready and not self.ctx.services.capsule then
        self.ctx.services.capsule = capsule_queries.new("/player#collision", self.ctx.world.adapter.by_id)
        self.ctx.services.capsule:sync(self.ctx.player.position, self.ctx.player.motion.height)
    end
    if self.weapon_drive then weapon_driver.before(self.ctx, self.weapon_drive) end
    runtime.fixed_update(self.ctx, dt)
    if self.weapon_drive then weapon_driver.after(self.ctx, self.weapon_drive) end
    -- Keep the GO and kinematic Bullet transform at the authoritative feet.
    local p = self.ctx.player.position
    self.position.x, self.position.y, self.position.z = p.x, p.y, p.z
    go.set_position(self.position, "/player")
end

function update(self, dt)
    runtime.update(self.ctx, dt)
    if automation_bridge and self.world_phase ~= self.ctx.world.phase then
        self.world_phase = self.ctx.world.phase
        automation_bridge.publish("world", world_snapshot(self.ctx.world))
    end
end

function late_update(self, dt)
    -- Camera and GUI see interpolated presentation, never drive simulation.
    local out = self.ctx.presentation
    ai_system.present(self.ctx)
    local view = self.view and self.ctx.world.views[self.view]
    local camera = view and view.position or out.camera
    audio_system.present(self.ctx,dt,camera,view and view.yaw or out.yaw)
    self.camera_position.x, self.camera_position.y, self.camera_position.z = camera.x, camera.y, camera.z
    go.set_position(self.camera_position, "/camera")
    go.set_rotation(vmath.quat_rotation_y(view and view.yaw or out.yaw) * vmath.quat_rotation_x(view and view.pitch or out.pitch)
        * vmath.quat_rotation_z(view and 0 or out.roll), "/camera")
    local visible = not view and self.ctx.world.ready and self.ctx.player.actor.alive
    local weapon_pose = weapon_adapter.update(self.weapon_visuals, self.ctx, dt, visible)
    go.set("/camera#camera", "fov", view and math.rad(70) or weapon_pose.world_fov)
    go.set("/viewmodel#camera", "fov", weapon_pose.view_fov)
    local weapon = weapon_system.snapshot(self.ctx)
    local ammo = string.format("%s  %s  %d / %d", weapon.label, string.upper(weapon.mode), weapon.ammo, weapon.reserve)
    local clip_labels = { reloadTac="RELOADING", reloadEmpty="RELOADING", inspect="INSPECTING",
        draw="EQUIPPING", holster="SWITCHING" }
    local weapon_status = clip_labels[weapon.clip] or ""
    local aiming = weapon.ads > 0.8
    local hit = self.ctx.fx.hitmarker > 0
    local hurt = self.ctx.fx.damage_flash > 0
    local loading = not self.ctx.world.ready
    local motion = self.ctx.player.motion
    local title = view and view.title or (motion.mantle and "MANTLE" or motion.sliding and "SLIDE"
        or motion.tactical and "TACTICAL SPRINT" or string.upper(motion.stance))
    if self.hud.health ~= out.health or self.hud.hit ~= hit or self.hud.hurt ~= hurt
        or self.hud.loading ~= loading or self.hud.title ~= title or self.hud.ammo ~= ammo
        or self.hud.weapon_status ~= weapon_status or self.hud.aiming ~= aiming then
        self.hud.health, self.hud.hit, self.hud.hurt = out.health, hit, hurt
        self.hud.loading, self.hud.title = loading, title
        self.hud.ammo, self.hud.weapon_status, self.hud.aiming = ammo, weapon_status, aiming
        msg.post("/hud#gui", HUD_STATE, self.hud)
    end
end

function on_input(self, action_id, action)
    if action_id==hash("restart_encounter") and action.pressed and self.ctx.world.ready then
        restart_encounter(self)
        return true
    end
    if action.pressed and (action_id == PLAY or action_id == ESCAPE) then
        if action_id == PLAY then select_view(self, nil) else select_view(self, self.view) end
        return true
    end
    if action_id == hash("firing_range") and action.pressed and self.ctx.world.ready then
        create_range(self)
        select_view(self, nil)
        player_system.reset(self.ctx, { x = -5, y = 0.01, z = 40 }, 0)
        return true
    end
    if action_id == COURSE and action.pressed and self.ctx.world.ready then
        create_course(self)
        select_view(self, nil)
        player_system.reset(self.ctx, { x = 56, y = 0.01, z = 0 }, 0)
        return true
    end
    if VIEW_ACTIONS[action_id] and action.pressed then
        select_view(self, VIEW_ACTIONS[action_id])
        return true
    end
    if not action_id then
        if window.get_mouse_lock() and not self.view then input.look(self.ctx.input, action.dx or 0, action.dy or 0) end
        return false
    end
    if action_id == hash("fire") and action.pressed and not window.get_mouse_lock() then
        select_view(self, nil)
        window.set_mouse_lock(true)
        return true
    end
    local name = actions[action_id]
    if name then return input.button(self.ctx.input, name, action) end
    return false
end

function on_message(self, message_id, message, sender)
    if message_id == hash("renderer_stats") then self.renderer_stats = message end
    if message_id == APPLY_DAMAGE then combat.request(self.ctx.combat, message) end
end

function final(self)
    window.set_mouse_lock(false)
    window.set_listener(nil)
    msg.post(".", "release_input_focus")
    -- Automation Bridge clears callbacks with the Lua application lifecycle.
    weapon_adapter.final(self.weapon_visuals, self.ctx)
    if self.range then firing_range.final(self.ctx, self.range) end
    runtime.final(self.ctx)
    if self.course then course.final(self.course) end
end
