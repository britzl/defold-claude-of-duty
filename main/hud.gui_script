local HUD_STATE = hash("hud_state")
local WHITE = vmath.vector4(0.9, 0.92, 0.95, 1)
local RED = vmath.vector4(1, 0.25, 0.2, 1)

function init(self)
    self.health = gui.new_text_node(vmath.vector3(32, 32, 0), "HEALTH 100")
    gui.set_font(self.health, "default")
    gui.set_pivot(self.health, gui.PIVOT_W)
    gui.set_id(self.health, "health")
    self.crosshair = gui.new_text_node(vmath.vector3(480, 320, 0), "+")
    gui.set_font(self.crosshair, "default")
    gui.set_id(self.crosshair, "crosshair")
    self.title = gui.new_text_node(vmath.vector3(32, 605, 0), "MARKET STREET")
    gui.set_font(self.title, "default")
    gui.set_pivot(self.title, gui.PIVOT_W)
    self.views = gui.new_text_node(vmath.vector3(928, 32, 0), "0 PLAY  1-3 VIEWS  4 COURSE  5 RANGE  9 RESTART")
    gui.set_font(self.views, "default")
    gui.set_pivot(self.views, gui.PIVOT_E)
    gui.set_color(self.views, WHITE)
    self.ammo = gui.new_text_node(vmath.vector3(928, 70, 0), "")
    gui.set_font(self.ammo, "default")
    gui.set_pivot(self.ammo, gui.PIVOT_E)
    gui.set_id(self.ammo, "ammo")
    self.weapon_status = gui.new_text_node(vmath.vector3(480, 220, 0), "")
    gui.set_font(self.weapon_status, "default")
    gui.set_scale(self.weapon_status, vmath.vector3(.7,.7,1))
    self.loading = gui.new_text_node(vmath.vector3(480, 280, 0), "LOADING")
    gui.set_font(self.loading, "default")
    local controls = gui.new_text_node(vmath.vector3(928, 590, 0), "WASD MOVE  SHIFT SPRINT  DOUBLE SHIFT TACTICAL\nCTRL CROUCH / SLIDE  SPACE JUMP / MANTLE\nZ PRONE  Q/E LEAN  CLICK LOOK  ESC CURSOR\nLMB FIRE  RMB AIM  R RELOAD  F INSPECT\n6/7/8 WEAPON  TAB CYCLE  B FIRE MODE")
    gui.set_font(controls, "default")
    gui.set_pivot(controls, gui.PIVOT_E)
    gui.set_scale(controls, vmath.vector3(0.75, 0.75, 1))
end

function on_message(self, message_id, message, sender)
    if message_id == HUD_STATE then
        gui.set_text(self.health, string.format("HEALTH %d", math.ceil(message.health)))
        gui.set_color(self.health, message.hurt and RED or WHITE)
        gui.set_text(self.crosshair, message.hit and "x" or message.aiming and "" or "+")
        gui.set_text(self.ammo, message.ammo or "")
        gui.set_text(self.weapon_status, message.weapon_status or "")
        gui.set_text(self.title, message.title)
        gui.set_enabled(self.loading, message.loading)
    end
end
