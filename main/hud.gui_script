local W = require "game.ui.widgets"
local model = require "game.ui.hud"
local menu = require "game.ui.menu"
local touch = require "game.ui.touch"
local TL = {gui.ANCHOR_LEFT,gui.ANCHOR_TOP}
local TR = {gui.ANCHOR_RIGHT,gui.ANCHOR_TOP}
local BL = {gui.ANCHOR_LEFT,gui.ANCHOR_BOTTOM}
local BR = {gui.ANCHOR_RIGHT,gui.ANCHOR_BOTTOM}
local TOP = {gui.ANCHOR_NONE,gui.ANCHOR_TOP}
local BOTTOM = {gui.ANCHOR_NONE,gui.ANCHOR_BOTTOM}
local SIZE, MX, MY = 148, 98, 510

function init(self)
    -- Anchor each cluster once. Children retain their local spacing when the
    -- window changes aspect; independently anchored map pieces would stretch.
    W.group(TL,0,640);W.group(TR,960,640)
    W.group(BL,0,0);W.group(BR,960,0)
    W.group(TOP,480,640);W.group(BOTTOM,480,0)
    self.menu=menu.new()
    self.touch=touch.new()
    self.map={}
    self.map_nodes={}
    self.map_geometry={}
    self.damage={}
    -- Edge washes stretch with the window; gameplay HUD elements retain aspect.
    for _,r in ipairs({{480,635,960,10},{480,5,960,10},{5,320,10,640},{955,320,10,640}}) do
        local node=W.box(nil,r[1],r[2],r[3],r[4],W.red,"damage")
        gui.set_adjust_mode(node,gui.ADJUST_STRETCH)
        gui.set_alpha(node,0)
        self.damage[#self.damage+1]=node
    end
    self.direction={
        front=W.box("damage_front",480,372,42,3,W.red,"damage"),
        back=W.box("damage_back",480,268,42,3,W.red,"damage"),
        left=W.box("damage_left",428,320,3,42,W.red,"damage"),
        right=W.box("damage_right",532,320,3,42,W.red,"damage"),
    }
    for _,node in pairs(self.direction) do gui.set_enabled(node,false) end
    self.title=W.text("title",24,610,"MARKET STREET",1,W.white,gui.PIVOT_W,"hud",TL)
    W.box("map_border",MX,MY,SIZE+4,SIZE+4,W.muted,"hud",TL)
    W.box("map_background",MX,MY,SIZE,SIZE,W.panel,"hud",TL)
    W.text(nil,24,421,"44m  /  NORTH UP",.67,W.muted,gui.PIVOT_W,"hud",TL)
    W.text("map_north",163,573,"N",.72,W.accent,nil,"markers",TL)
    self.map_player=W.text("map_player",MX,MY,"^",1.1,W.accent,nil,"markers",TL)
    self.compass={}
    W.box("compass_background",480,600,296,58,vmath.vector4(.025,.047,.06,.58),"hud",TOP)
    for i,label in ipairs({"N","NE","E","SE","S","SW","W","NW"}) do
        self.compass[i]=W.text("compass_"..label,480,609,label,.8,W.muted,nil,"hud",TOP)
    end
    W.box(nil,480,591,2,6,W.accent,"hud",TOP)
    self.bearing=W.text("heading",480,578,"000",.85,W.white,nil,"hud",TOP)
    self.fps=W.text("fps",936,610,"FPS --",.8,W.white,gui.PIVOT_E,"hud",TR)
    self.fps_frames,self.fps_elapsed=0,0
    self.feed=W.text("killfeed",936,572,"",.87,W.white,gui.PIVOT_NE,"hud",TR)
    W.box(nil,118,55,212,62,W.panel,"hud",BL)
    self.health=W.text("health",24,66,"HEALTH 100",1.15,W.white,gui.PIVOT_W,"hud",BL)
    W.box(nil,118,40,188,5,W.muted,"hud",BL)
    self.health_bar=W.box("health_bar",24,40,188,5,W.accent,"hud",BL)
    gui.set_pivot(self.health_bar,gui.PIVOT_W)
    self.stance=W.text("stance",24,102,"STAND",.75,W.muted,gui.PIVOT_W,"hud",BL)
    W.box(nil,754,55,388,62,W.panel,"hud",BR)
    self.ammo=W.text("ammo",936,64,"",1,W.white,gui.PIVOT_E,"hud",BR)
    self.ammo_hint=W.text(nil,936,40,"R  RELOAD   /   6  7  8  WEAPONS",.72,W.muted,gui.PIVOT_E,"hud",BR)
    self.weapon_status=W.text("weapon_status",480,132,"",.9,W.accent,nil,"hud",BOTTOM)
    self.hint=W.text("input_hint",480,17,"CLICK TO CAPTURE MOUSE  /  ESC MENU",.73,W.white,nil,"hud",BOTTOM)
    self.crosshair={}
    for i=1,4 do self.crosshair[i]=W.box("crosshair_"..i,480,320,i<3 and 5 or 1,i<3 and 1 or 5,W.white) end
    self.hit=W.text("hitmarker",480,320,"x",1.3,W.white)
    gui.set_enabled(self.hit,false)
    self.loading=W.text("loading",480,280,"GENERATING MARKET STREET...",1,W.white)
    self.death=W.text("death",480,350,"",1.5,W.white)
end

function update(self,dt)
    -- Sample GUI frames independently of the fixed simulation and pause state.
    if dt<=0 then return end
    self.fps_frames=self.fps_frames+1
    self.fps_elapsed=self.fps_elapsed+dt
    if self.fps_elapsed>=.5 then
        gui.set_text(self.fps,string.format("FPS %d",math.floor(self.fps_frames/self.fps_elapsed+.5)))
        self.fps_frames,self.fps_elapsed=0,0
    end
end

local function update_hud(self,state)
    local previous=self.hud_state or {}
    if state.diagnostic~=previous.diagnostic then
        for _,group in ipairs({TL,TR,BL,BR,TOP,BOTTOM}) do gui.set_enabled(group.root,not state.diagnostic) end
    end
    if state.health~=previous.health then
        gui.set_text(self.health,string.format("HEALTH %d",math.ceil(state.health)))
        gui.set_color(self.health,state.health<=30 and W.red or W.white)
        gui.set_color(self.health_bar,state.health<=30 and W.red or W.accent)
        gui.set_size(self.health_bar,vmath.vector3(math.max(.01,188*state.health/100),5,0))
    end
    if state.ammo~=previous.ammo then gui.set_text(self.ammo,state.ammo) end
    if state.weapon_status~=previous.weapon_status then gui.set_text(self.weapon_status,state.weapon_status) end
    if state.inspecting~=previous.inspecting or state.title~=previous.title then
        gui.set_text(self.title,state.inspecting and state.title or "MARKET STREET")
        gui.set_text(self.stance,state.inspecting and "INSPECTION" or state.title)
    end
    if state.feed~=previous.feed then gui.set_text(self.feed,state.feed) end
    if state.loading~=previous.loading then gui.set_enabled(self.loading,state.loading) end
    if state.alive~=previous.alive or state.diagnostic~=previous.diagnostic then
        gui.set_text(self.death,(state.alive or state.diagnostic) and "" or "YOU WERE ELIMINATED")
    end
    if state.alive~=previous.alive or state.mouse_locked~=previous.mouse_locked or state.touch_controls~=previous.touch_controls then
        gui.set_enabled(self.stance,not state.touch_controls)
        gui.set_text(self.ammo_hint,state.touch_controls and "TAP AIM / STANCE TO TOGGLE" or "R  RELOAD   /   6  7  8  WEAPONS")
        gui.set_text(self.hint,state.touch_controls and (state.alive and "DRAG RIGHT SIDE TO LOOK  /  DRAG FIRE TO SHOOT AND LOOK" or "TAP MENU TO RESTART ENCOUNTER")
            or not state.alive and "9  RESTART ENCOUNTER  /  ESC MENU"
            or state.mouse_locked and "WASD  MOVE  /  SHIFT  SPRINT  /  ESC MENU"
            or "CLICK TO CAPTURE MOUSE  /  ESC MENU")
    end
    for _,node in ipairs(self.damage) do
        gui.set_alpha(node,state.diagnostic and 0 or math.max(state.damage*.48,state.health>0 and state.health<=30 and .15 or 0))
    end
    for name,node in pairs(self.direction) do
        gui.set_enabled(node,state.damage_direction==name and state.damage>0 and state.alive and not state.diagnostic)
        gui.set_alpha(node,state.damage)
    end
    local gap=5+math.min(12,state.spread*1.4) -- weapon spread is already in degrees
    for i,node in ipairs(self.crosshair) do
        gui.set_enabled(node,not state.aiming and not state.loading and state.alive and not state.inspecting and not state.diagnostic)
        gui.set_position(node,vmath.vector3(480+(i==1 and -gap or i==2 and gap or 0),320+(i==3 and -gap or i==4 and gap or 0),0))
    end
    gui.set_enabled(self.hit,state.hit and state.alive and not state.inspecting and not state.diagnostic)
    gui.set_color(self.hit,state.headshot and W.accent or W.white)
    if state.heading~=previous.heading then
        gui.set_text(self.bearing,string.format("%03d",math.floor(state.heading+.5)%360))
        for i,node in ipairs(self.compass) do
            local delta=((i-1)*45-state.heading+180)%360-180
            gui.set_enabled(node,math.abs(delta)<=65)
            W.position(node,480+delta*2,609,TOP)
        end
    end
    if state.yaw~=previous.yaw then gui.set_euler(self.map_player,vmath.vector3(0,0,math.deg(state.yaw))) end
    self.hud_state=state
    -- Anchored nodes already follow window resizes. Reclip the north-up map
    -- only when its geometry or the player's exact position/floor changes.
    if not self.map_dirty and state.x==previous.x and state.y==previous.y and state.z==previous.z then return end
    self.map_dirty=false
    local visible=model.map_visible(self.map,state.x,state.y,state.z,SIZE)
    for i,rect in ipairs(visible) do
        local node=self.map_nodes[i]
        local old=self.map_geometry[i]
        if not node then
            node=W.box("map_"..i,MX,MY,1,1,W.muted,"map",TL)
            self.map_nodes[i]=node
        end
        if not old or i>(self.map_count or 0) then gui.set_enabled(node,true) end
        if not old or old.x~=rect.x or old.y~=rect.y then W.position(node,MX+rect.x,MY+rect.y,TL) end
        if not old or old.w~=rect.w or old.h~=rect.h then gui.set_size(node,vmath.vector3(rect.w,rect.h,0)) end
        -- Keep pooled nodes in their anchored parent. Moving relative to nil
        -- reparents them to the root and loses the top-left coordinate frame.
        if not old or old.floor~=rect.floor then
            gui.set_color(node,rect.floor and vmath.vector4(.15,.21,.23,1) or vmath.vector4(.48,.57,.57,1))
            gui.set_layer(node,rect.floor and "map_floor" or "map")
        end
        self.map_geometry[i]=rect
    end
    for i=#visible+1,self.map_count or 0 do gui.set_enabled(self.map_nodes[i],false) end
    self.map_count=#visible
end

function on_message(self,id,message,sender)
    if id==hash("hud_state") then update_hud(self,message)
    elseif id==hash("touch_state") then touch.update(self.touch,message)
    elseif id==hash("map_rect") then
        self.map[#self.map+1]=message
        self.map_dirty=true
    elseif id==hash("menu_state") then menu.state(self.menu,message)
    elseif id==hash("menu_input") then menu.input(self.menu,message) end
end
